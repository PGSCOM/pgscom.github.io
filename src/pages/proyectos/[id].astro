---
import Layout from '../../layouts/Layout.astro';
import '../../styles/proyecto-detalle.css';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import categoriasData from '../../data/categorias.json';
import { formatRangoFecha } from '../../utils/fechas.js';

// Genera una ruta estática por cada .md de src/content/proyectos/.
// Cada página es HTML real y rastreable por los bots de Google.
export async function getStaticPaths() {
	const cats = categoriasData.categorias;
	const entradas = await getCollection('proyectos');
	const proyectos = entradas.map((e) => ({ id: e.id, ...e.data }));
	return entradas.map((entrada) => {
		const proyecto = { id: entrada.id, ...entrada.data };
		const catIds = proyecto.categorias ?? [];
		// La primera categoría del proyecto actúa como principal
		const aptitud = cats.find((c) => c.id === catIds[0]) ?? cats[0];
		const relacionados = proyectos
			.filter((p) => p.id !== proyecto.id && (p.categorias ?? []).some((c) => catIds.includes(c)))
			.slice(0, 3);
		return {
			params: { id: proyecto.id },
			props: { entrada, proyecto, aptitud, relacionados },
		};
	});
}

const { entrada, proyecto, aptitud, relacionados } = Astro.props;
// El cuerpo markdown del .md se convierte en el contenido de la ficha
const { Content } = await render(entrada);

const fechaTexto = formatRangoFecha(proyecto.fecha, proyecto.fechaFin);
// La cabecera usa `trailer` (vídeo) o `portada` (ImageMetadata), con `imagen`
// como respaldo. Sin ninguna, se muestra el icono de la categoría.
const portada = proyecto.portada || proyecto.imagen;
// og:image y JSON-LD necesitan una URL string: .src es la ruta del asset
// optimizado; si el proyecto no tiene imagen, cae al logo (SVG) de la categoría.
const ogImagen = proyecto.imagen?.src ?? aptitud.logo;

const tituloPagina = `${proyecto.titulo.trim()} · ${aptitud.titulo} — PGSCOM`;
const descripcionPagina = proyecto.descripcion || `${proyecto.titulo} — proyecto de ${aptitud.titulo} de Pablo García Santamaría.`;

// Datos estructurados (Schema.org) para enriquecer el resultado en Google
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: proyecto.titulo.trim(),
	description: descripcionPagina,
	url: new URL(`/proyectos/${proyecto.id}`, Astro.site).href,
	image: new URL(ogImagen, Astro.site).href,
	genre: aptitud.titulo,
	keywords: (proyecto.tecnologias ?? []).join(', '),
	creator: {
		'@type': 'Person',
		name: 'Pablo García Santamaría',
		url: Astro.site?.href,
	},
	...(proyecto.premio && {
		award: proyecto.premio,
	}),
	...(proyecto.link && {
		sameAs: proyecto.link,
	}),
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: Astro.site?.href },
		{ '@type': 'ListItem', position: 2, name: 'Proyectos', item: new URL('/#proyectos-mapa', Astro.site).href },
		{ '@type': 'ListItem', position: 3, name: proyecto.titulo.trim(), item: new URL(`/proyectos/${proyecto.id}`, Astro.site).href },
	],
};
---

<Layout
	title={tituloPagina}
	description={descripcionPagina}
	image={ogImagen}
	type="article"
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

	<main class="pd-page">
		<a class="pd-back" href="/?sincarga#proyectos-mapa" aria-label="Volver a proyectos">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="19" y1="12" x2="5" y2="12"></line>
				<polyline points="12 19 5 12 12 5"></polyline>
			</svg>
			<span>Proyectos</span>
		</a>

		<!-- Cabecera cinematográfica: trailer o portada a pantalla completa -->
		<header class="pd-hero">
			{proyecto.trailer ? (
				<video
					class="pd-hero-media"
					src={proyecto.trailer}
					poster={portada?.src}
					autoplay
					muted
					loop
					playsinline
					aria-hidden="true"
				></video>
			) : portada ? (
				<Image
					class="pd-hero-media"
					src={portada}
					alt={proyecto.titulo.trim()}
					style="view-transition-name: project-hero"
					loading="eager"
				/>
			) : (
				<img
					class="pd-hero-media pd-hero-media--icono"
					src={aptitud.logo}
					alt={proyecto.titulo.trim()}
					style="view-transition-name: project-hero"
					loading="eager"
				/>
			)}

			<div class="pd-hero-overlay">
				<!-- Migas de pan rastreables -->
				<nav class="pd-breadcrumb" aria-label="Migas de pan">
					<a href="/">Inicio</a>
					<span aria-hidden="true">/</span>
					<a href="/?sincarga#proyectos-mapa">Proyectos</a>
					<span aria-hidden="true">/</span>
					<span class="pd-breadcrumb-current">{aptitud.titulo}</span>
				</nav>

				<div class="pd-hero-info">
					<p class="pd-categoria">
						<img src={aptitud.logo} alt="" aria-hidden="true" />
						<span>{aptitud.titulo}</span>
					</p>
					<h1 class="pd-titulo">{proyecto.titulo.trim()}</h1>

					<div class="pd-meta">
						{fechaTexto && <span class="pd-meta-item">📅 {fechaTexto}</span>}
						{proyecto.premio && <span class="pd-meta-badge">🏆 {proyecto.premio}</span>}
						{proyecto.tecnologias?.length && (
							<span class="pd-meta-item">{proyecto.tecnologias.length} tecnologías</span>
						)}
					</div>

					{proyecto.descripcion && <p class="pd-tagline">{proyecto.descripcion}</p>}

					<div class="pd-actions">
						{proyecto.link && (
							<a class="pd-btn-primary" href={proyecto.link} target="_blank" rel="noopener noreferrer">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
									<polygon points="5 3 19 12 5 21 5 3"></polygon>
								</svg>
								<span>Visitar proyecto</span>
							</a>
						)}
					</div>
				</div>
			</div>
		</header>

		<article class="pd-wrapper">
			<div class="pd-body">
				{proyecto.tecnologias?.length && (
					<section class="pd-tecnologias" aria-label="Tecnologías">
						{proyecto.tecnologias.map((tech) => (
							<span class="pd-tech-tag" data-tech={tech}>{tech}</span>
						))}
					</section>
				)}

				<section class="pd-contenido">
					<Content />
				</section>

				{relacionados.length > 0 && (
					<section class="pd-relacionados">
						<h2 class="pd-relacionados-titulo">Más de {aptitud.titulo}</h2>
						<div class="pd-relacionados-grid">
							{relacionados.map((rel) => (
								<a class="pd-rel-card" href={`/proyectos/${rel.id}`}>
									<div class="pd-rel-image">
										{rel.imagen ? (
											<Image src={rel.imagen} alt={rel.titulo.trim()} loading="lazy" />
										) : (
											<img src={aptitud.logo} alt="" aria-hidden="true" loading="lazy" />
										)}
									</div>
									<div class="pd-rel-info">
										<h3 class="pd-rel-titulo">{rel.titulo.trim()}</h3>
										{rel.descripcion && <p class="pd-rel-desc">{rel.descripcion}</p>}
									</div>
								</a>
							))}
						</div>
					</section>
				)}
			</div>
		</article>
	</main>

</Layout>
