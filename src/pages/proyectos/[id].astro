---
import Layout from '../../layouts/Layout.astro';
import ProyectoHero from '../../components/ProyectoHero.astro';
import TemaToggle from '../../components/TemaToggle.astro';
import '../../styles/proyecto-detalle.css';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import categoriasData from '../../data/categorias.json';
import { formatRangoFecha } from '../../utils/fechas.js';

// Genera una ruta estática por cada .md de src/content/proyectos/.
// Cada página es HTML real y rastreable por los bots de Google.
export async function getStaticPaths() {
	const cats = categoriasData.categorias;
	const todasLasEntradas = await getCollection('proyectos');
	const proyectos = todasLasEntradas.map((e) => ({ id: e.id, ...e.data }));
	// "multiguerras" tiene su propio micrositio a medida en
	// src/pages/proyectos/multiguerras.astro (demasiados subproyectos para
	// esta plantilla genérica de pestañas); se excluye aquí para que no
	// colisionen ambas rutas en /proyectos/multiguerras.
	const entradas = todasLasEntradas.filter((e) => e.id !== 'multiguerras');
	return entradas.map((entrada) => {
		const proyecto = { id: entrada.id, ...entrada.data };
		const catIds = proyecto.categorias ?? [];
		// La primera categoría del proyecto actúa como principal
		const aptitud = cats.find((c) => c.id === catIds[0]) ?? cats[0];
		const relacionados = proyectos
			.filter((p) => p.id !== proyecto.id && (p.categorias ?? []).some((c) => catIds.includes(c)))
			.slice(0, 3);
		return {
			params: { id: proyecto.id },
			props: { entrada, proyecto, aptitud, relacionados },
		};
	});
}

const { entrada, proyecto, aptitud, relacionados } = Astro.props;
// El cuerpo markdown del .md se convierte en el contenido de la ficha
const { Content } = await render(entrada);

const fechaTexto = formatRangoFecha(proyecto.fecha, proyecto.fechaFin);
// La cabecera usa `trailer` (vídeo) o `portada` (ImageMetadata), con `imagen`
// como respaldo. Sin ninguna, se muestra el icono de la categoría.
const portada = proyecto.portada || proyecto.imagen;
// og:image y JSON-LD necesitan una URL string: .src es la ruta del asset
// optimizado; si el proyecto no tiene imagen, cae al logo (SVG) de la categoría.
const ogImagen = proyecto.imagen?.src ?? aptitud.logo;

const tituloPagina = `${proyecto.titulo.trim()} · ${aptitud.titulo} — PGSCOM`;
const descripcionPagina = proyecto.descripcion || `${proyecto.titulo} — proyecto de ${aptitud.titulo} de Pablo García Santamaría.`;

// Datos estructurados (Schema.org) para enriquecer el resultado en Google
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: proyecto.titulo.trim(),
	description: descripcionPagina,
	url: new URL(`/proyectos/${proyecto.id}`, Astro.site).href,
	image: new URL(ogImagen, Astro.site).href,
	genre: aptitud.titulo,
	keywords: (proyecto.tecnologias ?? []).join(', '),
	creator: {
		'@type': 'Person',
		name: 'Pablo García Santamaría',
		url: Astro.site?.href,
	},
	...(proyecto.premio && {
		award: proyecto.premio,
	}),
	...(proyecto.link && {
		sameAs: proyecto.link,
	}),
};

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Inicio', item: Astro.site?.href },
		{ '@type': 'ListItem', position: 2, name: 'Proyectos', item: new URL('/#proyectos-mapa', Astro.site).href },
		{ '@type': 'ListItem', position: 3, name: proyecto.titulo.trim(), item: new URL(`/proyectos/${proyecto.id}`, Astro.site).href },
	],
};
---

<Layout
	title={tituloPagina}
	description={descripcionPagina}
	image={ogImagen}
	type="article"
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

	<main class="pd-page">
		<script is:inline>
			// Antes de pintar: si el usuario ya eligió el modo claro en otra
			// ficha, se respeta aquí también (si no, el cuerpo nace en oscuro).
			if (localStorage.getItem('pd-tema') === 'claro') {
				document.currentScript.closest('.pd-page').setAttribute('data-theme', 'claro');
			}
		</script>

		<a class="pd-back" href="/?sincarga#proyectos-mapa" aria-label="Volver a proyectos">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<line x1="19" y1="12" x2="5" y2="12"></line>
				<polyline points="12 19 5 12 12 5"></polyline>
			</svg>
			<span>Proyectos</span>
		</a>

		<TemaToggle />

		<!-- Cabecera cinematográfica: trailer o portada a pantalla completa -->
		<ProyectoHero
			titulo={proyecto.titulo.trim()}
			breadcrumbActual={aptitud.titulo}
			descripcion={proyecto.descripcion}
			fechaTexto={fechaTexto}
			premio={proyecto.premio}
			link={proyecto.link}
			txtboton={proyecto.txtboton}
			portada={portada}
			trailer={proyecto.trailer}
			logoFallback={aptitud.logo}
		/>

		<article class="pd-wrapper">
			<div class="pd-body">

				<section class="pd-contenido">
					<Content />
				</section>

				<script is:inline define:vars={{ categorias: categoriasData.categorias.map((c) => ({ id: c.id, color: c.color, logo: c.logo })) }}>
					// Convierte en pestañas los h2 que tengan data-tab="id-categoria".
					// Se ejecuta de forma síncrona, antes de que el navegador pinte la
					// página, para que un enlace con ancla abra directamente la pestaña
					// correcta sin saltos. Si hay menos de dos h2 con data-tab, no hace nada.
					(function () {
						const contenido = document.querySelector('.pd-contenido');
						if (!contenido) return;

						const headings = Array.from(contenido.children).filter(
							(el) => el.tagName === 'H2' && el.hasAttribute('data-tab')
						);
						if (headings.length < 2) return;

						function slugify(texto) {
							return texto
								.toLowerCase()
								.normalize('NFD')
								.replace(/[̀-ͯ]/g, '')
								.replace(/[^a-z0-9]+/g, '-')
								.replace(/^-+|-+$/g, '');
						}

						// Marca el hueco donde iban los h2: se sustituye al final por la
						// barra de pestañas y el contenedor de paneles.
						const marcador = document.createComment('pd-tabs');
						contenido.insertBefore(marcador, headings[0]);

						const usados = new Set();
						const paneles = headings.map((h2, i) => {
							let slug = slugify(h2.textContent) || `seccion-${i + 1}`;
							while (usados.has(slug)) slug += `-${i + 1}`;
							usados.add(slug);

							const panel = document.createElement('div');
							panel.className = 'pd-tab-panel';
							panel.id = slug;
							panel.setAttribute('role', 'region');
							panel.setAttribute('aria-label', h2.textContent);

							// Mueve el h2 y todo lo que le sigue hasta el próximo h2 (o el final)
							let nodo = h2;
							while (nodo && nodo !== headings[i + 1]) {
								const siguiente = nodo.nextSibling;
								panel.appendChild(nodo);
								nodo = siguiente;
							}

							const cat = categorias.find((c) => c.id === h2.dataset.tab) || null;
							return { slug, etiqueta: h2.textContent, panel, cat };
						});

						const nav = document.createElement('nav');
						nav.className = 'pd-tabs';
						nav.setAttribute('aria-label', 'Secciones del proyecto');

						const lista = document.createElement('div');
						lista.className = 'pd-tabs-list';

						const enlaces = paneles.map(({ slug, etiqueta, cat }) => {
							const a = document.createElement('a');
							a.className = 'pd-tab';
							a.href = `#${slug}`;
							if (cat) {
								a.style.setProperty('--tab-color', cat.color);
								const img = document.createElement('img');
								img.src = cat.logo;
								img.alt = '';
								img.setAttribute('aria-hidden', 'true');
								a.appendChild(img);
							}
							const span = document.createElement('span');
							span.textContent = etiqueta;
							a.appendChild(span);
							lista.appendChild(a);
							return a;
						});
						nav.appendChild(lista);

						const panelesWrap = document.createElement('div');
						panelesWrap.className = 'pd-tab-panels';
						paneles.forEach(({ panel }) => panelesWrap.appendChild(panel));

						marcador.replaceWith(nav, panelesWrap);

						function activar(slug) {
							const objetivo = paneles.find((p) => p.slug === slug) || paneles[0];
							paneles.forEach((p) => {
								p.panel.hidden = p !== objetivo;
							});
							enlaces.forEach((a) => {
								const act = a.getAttribute('href') === `#${objetivo.slug}`;
								a.classList.toggle('act', act);
								a.setAttribute('aria-current', act ? 'true' : 'false');
							});
						}

						activar(decodeURIComponent(location.hash.slice(1)));

						lista.addEventListener('click', (e) => {
							const a = e.target.closest('.pd-tab');
							if (!a) return;
							e.preventDefault();
							const slug = a.getAttribute('href').slice(1);
							activar(slug);
							history.replaceState(null, '', `#${slug}`);
						});

						window.addEventListener('hashchange', () => {
							activar(decodeURIComponent(location.hash.slice(1)));
						});
					})();
				</script>

				<script src="../../scripts/proyecto-video.js"></script>
				<script src="../../scripts/proyecto-galeria.js"></script>
				<script src="../../scripts/proyecto-scroll-hint.js"></script>

				{relacionados.length > 0 && (
					<section class="pd-relacionados">
						<h2 class="pd-relacionados-titulo">Más de {aptitud.titulo}</h2>
						<div class="pd-relacionados-grid">
							{relacionados.map((rel) => (
								<a class="pd-rel-card" href={`/proyectos/${rel.id}`}>
									<div class="pd-rel-image">
										{rel.imagen ? (
											<Image src={rel.imagen} alt={rel.titulo.trim()} loading="lazy" />
										) : (
											<img src={aptitud.logo} alt="" aria-hidden="true" loading="lazy" />
										)}
									</div>
									<div class="pd-rel-info">
										<h3 class="pd-rel-titulo">{rel.titulo.trim()}</h3>
										{rel.descripcion && <p class="pd-rel-desc">{rel.descripcion}</p>}
									</div>
								</a>
							))}
						</div>
					</section>
				)}
			</div>
		</article>
	</main>

</Layout>
