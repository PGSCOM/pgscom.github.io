---
 // #region 📦 IMPORTS Y CONFIGURACIÓN INICIAL
 import Layout from '../layouts/Layout.astro';
 import './_styles.css';
 import '../styles/proyectos.css';
 import { Image } from 'astro:assets';
 import pgscom from '../assets/pgscom.png';
 import minimal1 from '../assets/minimal1.svg';
 import customShape from '../assets/custom-shape.svg';
 import minimal3 from '../assets/minimal3.svg';
 import logo from '../assets/logo.png';
 import logosvganim from '../assets/animlogo/logo.svg';
 import LiquidGlassComponent from '../components/liquidglasscomponent.jsx';
 
 // Importar datos de proyectos
 import proyectosData from '../data/proyectos.json';
 // #endregion
---

<Layout>
	<!-- #region 🎯 SECCIÓN PRINCIPAL - Partículas flotantes y texto animado -->
	<!--div class="sky-image">
		<a href="/">
			<Image src={logo} height={70} alt="Logo PGSCOM" />
		</a>
	</div-->
	<main class="main-container">
		<div class="particles">
			<Image src={minimal1} alt="" class="particle particle-1" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-2" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-3" width={100} height={100} />
			<Image src={minimal1} alt="" class="particle particle-4" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-5" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-6" width={100} height={100} />
		</div>
		<div class="content">
			<h1 id="animated-text" class="logo-text">PGSCOM</h1>
		</div>
	</main>
	<!-- #endregion -->

	<!-- #region 🧑‍💻 PERSONAJE PGSCOM - Imagen principal del personaje -->
	<div class="image-container">
		<Image src={pgscom} alt="PGSCOM Character" class="fotopgs" width={2617} height={3490} loading="eager" />
	</div>
	<!-- #endregion -->

	<!-- #region 🌌 SECCIÓN GALAXIA - Video con sticky scroll y logo animado -->
	<!-- Div que ocupa el 100% de la pantalla que contiene el logo en el centro -->
	<div class="parte2">
		<div class="galaxiamask">
			<!-- Video Galaxia bucle -->
			<canvas id="galaxia-seq" class="video-galaxia" style="opacity:0;"></canvas>
			<video muted playsinline preload="auto" id="video-galaxia-a" class="video-galaxia"></video>
			<video muted playsinline preload="auto" id="video-galaxia-b" class="video-galaxia" style="opacity:0;"></video>
		</div>
		<img id="logoanimar" style="width: auto; height: 32.3%;" src={logosvganim.src} alt="" />
		<!-- El width sería 18% (698/3840) y el height sería 32.3% (698/2160) -->
	</div>
	<!-- #endregion -->

	<!-- #region 📌 SCRIPT: STICKY SCROLL OPTIMIZADO - Control de posición fija con IntersectionObserver -->
	<script is:inline>
		// Optimizado con IntersectionObserver (sin listeners de scroll) + ResizeObserver.
		(() => {
			const parte = document.querySelector('.parte2');
			if (!parte) return;

			// Placeholder para evitar salto cuando .parte2 se fija
			const placeholder = document.createElement('div');
			placeholder.style.width = '100%';
			placeholder.style.display = 'none';
			parte.parentNode.insertBefore(placeholder, parte.nextSibling);

			// Mantener altura del placeholder sincronizada con el elemento
			const syncPlaceholder = () => {
				placeholder.style.height = `${parte.getBoundingClientRect().height}px`;
			};
			syncPlaceholder();
			const ro = new ResizeObserver(syncPlaceholder);
			ro.observe(parte);
			window.addEventListener('resize', syncPlaceholder);

			// Sentinel antes de .parte2 para detectar cruce con el viewport
			const sentinel = document.createElement('div');
			sentinel.setAttribute('aria-hidden', 'true');
			sentinel.style.height = '1px';
			sentinel.style.width = '100%';
			sentinel.style.pointerEvents = 'none';
			parte.parentNode.insertBefore(sentinel, parte);

			const io = new IntersectionObserver((entries) => {
				const entry = entries[0];
				// Determinar posición real del sentinel respecto al viewport
				const rect = sentinel.getBoundingClientRect();
				const rootTop = entry.rootBounds ? entry.rootBounds.top : 0; // 0 = borde superior del viewport
				const rootBottom = entry.rootBounds ? entry.rootBounds.bottom : window.innerHeight;

				// Reglas:
				// - Si el sentinel está visible (intersecting), quitar "stuck".
				// - Si NO está visible y su top < rootTop (ha pasado por arriba), poner "stuck".
				// - Si NO está visible y su top > rootBottom (está por debajo, aún no se ha llegado), quitar "stuck".
				if (entry.isIntersecting) {
					if (parte.classList.contains('stuck')) {
						parte.classList.remove('stuck');
						placeholder.style.display = 'none';
						// al quitar stuck:
						window._parte2StickyStart = null;
					}
				} else if (rect.top < rootTop) {
					// --- REPARACIÓN: calcular start que preserve el progreso actual ---
					if (!parte.classList.contains('stuck')) {
						parte.classList.add('stuck');
						placeholder.style.display = 'block';

						// Datos auxiliares
						const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 1;
						const scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;

						// ANIMATION_VH debe ser la misma que uses en onScroll (por ejemplo 2)
						const ANIMATION_VH = (window._ANIMATION_VH != null) ? window._ANIMATION_VH : 2;

						// Calcular el "progress de fallback" que habría antes de sticky
						const fallbackProgress = Math.max(0, Math.min(scrollY / (ANIMATION_VH * viewportHeight), 1));

						// Sólo asignamos start si aún no existe (evita reinicios por jitter)
						if (window._parte2StickyStart == null) {
							// start tal que (scrollY - start) / (ANIMATION_VH * vh) === fallbackProgress
							window._parte2StickyStart = scrollY - (fallbackProgress * ANIMATION_VH * viewportHeight);
						}
					}
				} else {
					if (parte.classList.contains('stuck')) {
						parte.classList.remove('stuck');
						placeholder.style.display = 'none';
						// al quitar stuck:
						window._parte2StickyStart = null;
					}
				}
			}, { root: null, threshold: 0 });

			io.observe(sentinel);

			// Asegurar estado inicial correcto en iOS cuando se carga arriba del todo
			if ((window.scrollY ?? window.pageYOffset ?? document.documentElement.scrollTop ?? 0) <= 0) {
				parte.classList.remove('stuck');
				placeholder.style.display = 'none';
				// al quitar stuck:
				window._parte2StickyStart = null;
			}
		})();
	</script>
	<!-- #endregion -->
	<!-- #region 🚧 SECCIONES TEMPORALES - Placeholder para contenido futuro -->
	<div style="height: 120vh; display: flex; align-items: center; justify-content: center;"></div>

	<!-- #region 📂 SECCIÓN DE PROYECTOS - Diseño circular con logo central -->
	<section class="proyectos-section">
		<div class="proyectos-container">
			<!-- Grid de aptitudes girando alrededor (órbita inicial) -->
			<div class="proyectos-grid">
				{proyectosData.map((aptitud) => (
					<div class="proyecto-card" data-aptitud-id={aptitud.id}>
						<div class="proyecto-card-inner">
							<div class="proyecto-icon">
								<img src={aptitud.logo} alt={aptitud.titulo} />
							</div>
							<h3 class="proyecto-titulo">{aptitud.titulo}</h3>
							<p class="proyecto-descripcion">{aptitud.descripcion}</p>
						</div>
					</div>
				))}
			</div>

			<!-- Logo en el centro (siempre visible) -->
			<div class="proyectos-logo">
				<Image src={logo} alt="PGSCOM Logo" width={720} height={720} />
			</div>

			<!-- Pantallas de detalle por aptitud (generadas proceduralmente) -->
			{proyectosData.map((aptitud, index) => (
				<div class="aptitud-detail-screen" data-aptitud-id={aptitud.id} data-index={index}>
					<!-- Línea que conecta logo con el círculo de aptitud -->
					<div class="line-logo-aptitud"></div>
					
					<!-- Círculo de aptitud (centro) -->
					<div class="aptitud-circle">
						<img src={aptitud.logo} alt={aptitud.titulo} />
						<span class="aptitud-title">{aptitud.titulo}</span>
					</div>
					
					<!-- Líneas que conectan aptitud con proyectos -->
					<div class="lines-to-projects">
						{aptitud.proyectos && aptitud.proyectos.map((_, pIndex) => (
							<div class="line-aptitud-proyecto" data-project-index={pIndex}></div>
						))}
					</div>
					
					<!-- Proyectos de esta aptitud -->
					<div class="proyectos-list">
						{aptitud.proyectos && aptitud.proyectos.map((proyecto, pIndex) => (
							<div class="proyecto-detail-card" data-project-index={pIndex}>
								<div class="proyecto-image-container">
									<img src={proyecto.imagen} alt={proyecto.titulo} class="proyecto-image" />
								</div>
								<div class="proyecto-info">
									<h4 class="proyecto-detail-titulo">{proyecto.titulo}</h4>
									{proyecto.descripcion && (
										<p class="proyecto-detail-desc">{proyecto.descripcion}</p>
									)}
								</div>
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</section>
	<!-- #endregion -->
	<!-- #endregion -->

	<!-- #region 🌀 SCRIPT: Órbita con pausa suave -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const container = document.querySelector('.proyectos-section .proyectos-container');
			if (!container) return;

			const cards = Array.from(container.querySelectorAll('.proyecto-card'));
			if (cards.length === 0) return;

			const TWO_PI = Math.PI * 2;

			// Más lento: 1 vuelta cada 90s (ajusta aquí si quieres)
			const REV_SECONDS = 90;
			const DEFAULT_SPEED = TWO_PI / REV_SECONDS; // rad/s
			const SMOOTH_TAU_STOP = 0.22; // s (frenada)
			const SMOOTH_TAU_START = 0.35; // s (arranque)

			let angle = 0;
			let speed = DEFAULT_SPEED;
			let targetSpeed = DEFAULT_SPEED;
			let lastT = performance.now();

			const baseAngles = cards.map((_, index) => (TWO_PI * index) / cards.length);

			const readRadius = () => {
				const raw = getComputedStyle(container).getPropertyValue('--orbit-radius').trim();
				const radius = Number.parseFloat(raw);
				return Number.isFinite(radius) ? radius : 350;
			};

			const setPaused = (paused) => {
				targetSpeed = paused ? 0 : DEFAULT_SPEED;
			};

			// Pausa estable aunque las tarjetas estén moviéndose bajo el cursor:
			// guardamos última posición del ratón y hacemos hit-test cada frame.
			let pointerActive = false;
			let pointerX = 0;
			let pointerY = 0;
			let hoverOffAt = 0;
			const HOVER_RELEASE_DELAY_MS = 140;

			container.addEventListener('pointerenter', (e) => {
				pointerActive = true;
				pointerX = e.clientX;
				pointerY = e.clientY;
			});
			container.addEventListener('pointermove', (e) => {
				pointerActive = true;
				pointerX = e.clientX;
				pointerY = e.clientY;
			});
			container.addEventListener('pointerleave', () => {
				pointerActive = false;
				hoverOffAt = 0;
				setPaused(false);
			});

			const tick = (t) => {
				const dt = Math.min(0.05, Math.max(0.001, (t - lastT) / 1000));
				lastT = t;

				// Hover real sobre tarjeta (sin depender de enter/leave de elementos en movimiento)
				if (pointerActive) {
					const el = document.elementFromPoint(pointerX, pointerY);
					const isOnCard = !!(el && container.contains(el) && el.closest('.proyecto-card'));
					if (isOnCard) {
						hoverOffAt = 0;
						setPaused(true);
					} else {
						if (!hoverOffAt) hoverOffAt = t;
						if (t - hoverOffAt > HOVER_RELEASE_DELAY_MS) setPaused(false);
					}
				}

				// Suavizar aceleración/frenada
				const tau = (targetSpeed < speed) ? SMOOTH_TAU_STOP : SMOOTH_TAU_START;
				const k = 1 - Math.exp(-dt / tau);
				speed += (targetSpeed - speed) * k;
				// Importante: no hacer modulo aquí para evitar micro-saltos al cruzar 0/360
				angle += speed * dt;

				const r = readRadius();
				for (let i = 0; i < cards.length; i += 1) {
					const a = angle + baseAngles[i];
					const deg = (a * 180) / Math.PI;
					cards[i].style.transform = `translate(-50%, -50%) rotate(${deg}deg) translateX(${r}px) rotate(${-deg}deg)`;
				}

				requestAnimationFrame(tick);
			};

			requestAnimationFrame(tick);
		});
	</script>
	<!-- #endregion -->

	<!-- #region 🎨 SCRIPT: ANIMACIÓN DE FUENTES - Rotación automática de tipografías -->
	<script is:inline defer>
		document.addEventListener('DOMContentLoaded', async () => {
			const animatedText = document.getElementById('animated-text');
			
			// Array de fuentes disponibles
			const fonts = [
				'Allerta Stencil',
				'Bungee Inline',
				'Chakra Petch',
				'Kranky',
				'Limelight',
				'Meow Script',
				'Modak',
				'Monoton',
				'Offside',
				'Pacifico',
				'Permanent Marker',
				'Rampart One',
				'Solway',
				'Tapestry',
				'Tiny5',
			];
			
			// Factor de escala para cada fuente para mantener tamaño visual consistente
			const fontSizeFactors = {
				'Allerta Stencil': 1.0,
				'Bungee Inline': 0.9,
				'Chakra Petch': 1,
				'Kranky': 1.0,
				'Limelight': 0.95,
				'Meow Script': 0.85,
				'Modak': 1.0,
				'Monoton': 0.8,
				'Offside': 1.1,
				'Pacifico': 0.8,
				'Permanent Marker': 1.0,
				'Rampart One': 0.8,
				'Solway': 1.15,
				'Tapestry': 1.05,
				'Tiny5': 1.2,
			};
			
			// Base font size in viewport width units
			const baseFontSize = 7; // corresponde al 7cqw en CSS
			const delayfont = 5000;
			
			// Variables de duración de transición
			const transitionDuration = {
				fadeOut: 600,    // Duración del fade-out en ms
				fadeIn: 800,     // Duración del fade-in en ms
				get total() { return this.fadeOut + this.fadeIn; } // Duración total
			};
			
			let currentFontIndex = 0;
			let fontsLoaded = false;

			// Función para precargar todas las fuentes
			async function preloadFonts() {
				console.log('Precargando fuentes...');
				
				try {
					// Usar Font Loading API si está disponible
					if ('fonts' in document) {
						const fontPromises = fonts.map(fontName => {
							// Usar peso Medium (500) para Solway y Chakra Petch
							// Usar peso Regular (400) para Modak, Monoton
							// Bold para el resto
							let fontWeight = 'bold';
							if (fontName === 'Solway' || fontName === 'Chakra Petch') {
								fontWeight = '500';
							} else if (fontName === 'Modak' || fontName === 'Monoton') {
								fontWeight = '400';
							}
							return document.fonts.load(`${fontWeight} 5rem "${fontName}"`);
						});
						
						await Promise.all(fontPromises);
						console.log('Todas las fuentes cargadas via Font Loading API');
					} else {
						// Fallback: crear elementos invisibles para forzar la carga
						const testContainer = document.createElement('div');
						testContainer.style.position = 'absolute';
						testContainer.style.visibility = 'hidden';
						testContainer.style.fontSize = '5rem';
						testContainer.style.fontWeight = 'bold';
						document.body.appendChild(testContainer);
						
						const loadPromises = fonts.map(fontName => {
							return new Promise((resolve) => {
								const testElement = document.createElement('span');
								testElement.textContent = 'PGSCOM';
								testElement.style.fontFamily = `"${fontName}", cursive`;
								// Aplicar peso específico para cada fuente
								if (fontName === 'Solway' || fontName === 'Chakra Petch') {
									testElement.style.fontWeight = '500';
								} else if (fontName === 'Modak' || fontName === 'Monoton') {
									testElement.style.fontWeight = '400';
								} else {
									testElement.style.fontWeight = 'bold';
								}
								testContainer.appendChild(testElement);
								
								// Esperar un poco para asegurar la carga
								setTimeout(() => {
									testContainer.removeChild(testElement);
									resolve();
								});
							});
						});
						
						await Promise.all(loadPromises);
						document.body.removeChild(testContainer);
						console.log('Todas las fuentes cargadas via fallback');
					}
					
					fontsLoaded = true;
				} catch (error) {
					console.log('Error cargando fuentes:', error);
					fontsLoaded = true; // Continuar de todos modos
				}
			}

			function changeFontFamily() {
				if (!fontsLoaded) return;
				
				// Usamos la referencia global
				const currentEl = window.animatedText;
				
				// Iniciar fade-out con blur
				currentEl.classList.add('fade-out');
				
				// Esperar a que se complete el fade-out antes de cambiar la fuente
				setTimeout(() => {
					// Cambiar a la siguiente fuente
					currentFontIndex = (currentFontIndex + 1) % fonts.length;
					const currentFont = fonts[currentFontIndex];
					
					// Cambiar la fuente mientras está invisible
					currentEl.style.fontFamily = `"${currentFont}", cursive`;
					
					// Aplicar peso específico para cada tipo de fuente
					if (currentFont === 'Solway' || currentFont === 'Chakra Petch') {
						currentEl.style.fontWeight = '500';
					} else if (currentFont === 'Modak' || currentFont === 'Monoton') {
						currentEl.style.fontWeight = '400';
					} else {
						currentEl.style.fontWeight = 'bold';
					}
					
					// Ajustar el tamaño según el factor de la fuente
					const factor = fontSizeFactors[currentFont] || 1.0;
					let newSize = baseFontSize * factor;
					// Duplicar tamaño en móvil
					if (window.matchMedia('(max-width: 768px)').matches) {
						newSize *= 2;
					}
					currentEl.style.fontSize = `${newSize}cqw`;
					
					console.log(`Font changed to: ${currentFont} (weight: ${currentEl.style.fontWeight}, factor: ${factor}, size: ${newSize}cqw)`);
					
					// Iniciar fade-in
					currentEl.classList.remove('fade-out');
					currentEl.classList.add('fade-in');
					
					// Remover la clase de fade-in después de completar la animación
					setTimeout(() => {
						currentEl.classList.remove('fade-in');
					}, transitionDuration.fadeIn);
					
				}, transitionDuration.fadeOut);
			}

			// Inicializar con la primera fuente y estado de carga
			const initialFont = fonts[0];
			animatedText.style.fontFamily = `"${initialFont}", cursive`;
			if (initialFont === 'Solway' || initialFont === 'Chakra Petch') {
				animatedText.style.fontWeight = '500';
			} else if (initialFont === 'Modak' || initialFont === 'Monoton') {
				animatedText.style.fontWeight = '400';
			} else {
				animatedText.style.fontWeight = 'bold';
			}
			
			// Aplicar el factor de escala inicial
			const initialFactor = fontSizeFactors[initialFont] || 1.0;
			// Ajustar tamaño según resolución: duplicar en móvil
			let initSize = baseFontSize * initialFactor;
			if (window.matchMedia('(max-width: 768px)').matches) {
				  initSize *= 2;
			}
			animatedText.style.fontSize = `${initSize}cqw`;
			
			animatedText.classList.add('loading');
			
			// Precargar todas las fuentes
			await preloadFonts();
			
			// Remover estado de carga y comenzar animación
			animatedText.classList.remove('loading');
			animatedText.classList.add('loaded');
			
			// Comenzar la animación solo después de cargar las fuentes
			console.log('Iniciando animación de fuentes...');
			
			// Referencia al elemento para que pueda ser actualizado en changeFontFamily
			window.animatedText = animatedText;
			
			setInterval(changeFontFamily, delayfont);
		});
	</script>
	<!-- #endregion -->
	<!-- #region 🎬 SCRIPT: ANIMACIONES SCROLL - Timeline principal con videos y secuencias -->
	<script type="module">
    import anime from 'https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js';

    function initScrollAnim() {
        const targetEl = document.querySelector('.image-container');
        const logoEl = document.querySelector('#logoanimar');
	const galaxiaMaskEl = document.querySelector('.galaxiamask');
		const videoA = document.querySelector('#video-galaxia-a');
		const videoB = document.querySelector('#video-galaxia-b');
	const seqCanvas = document.querySelector('#galaxia-seq');

	if (!targetEl || !logoEl || !galaxiaMaskEl || !videoA || !videoB || !seqCanvas) return;

        // Detectar si es móvil
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        
	// #region 🎯 CONFIGURACIÓN TIMELINE - Definición de animaciones con AnimeJS
	// Crear una timeline para mejor control de la animación
	const timeline = anime.timeline({
            autoplay: false,
            easing: 'easeOutQuart',
            duration: 1000 // Duración base más larga
        });

        // Agregar animaciones a la timeline (simultaneas)
		// #region ✨ DEFINICIÓN DE ANIMACIONES
		timeline
			// Ocultar el logo al inicio de la timeline
			/*.add({
				targets: logoEl,
				opacity: [0, 0],
				duration: 1
			}, 0)*/
            .add({
                targets: targetEl,
                /*translateX: isMobile ? 0 : 300,*/ // No mover horizontalmente en móvil
                /*translateY: isMobile ? 250 : 0,*/ // Mover verticalmente solo en móvil
                opacity: [1, 0], // Fade out simultáneo
                scale: [1, 0.8], // Reducir escala suavemente
                duration: isMobile ? 311 : 800, // Duración más larga para suavidad
                easing: 'easeOutQuart' // Easing más suave
            })
            .add({
                targets: logoEl,
				//opacity: [{ value: 1, duration: 1 }],
                scale: [1, 25], // Ampliar el logo de 1x a 25x
				translateY: [0, 45], // Desplazamiento hacia arriba
                duration: 1000,
                easing: 'easeInQuad',
                // Fusión: actualizar la máscara aquí para que esté sincronizada con el zoom del logo
                update: function(anim) {
                    // Declarar el tamaño en vh a partir del tamaño visual actual (incluye transform: scale)
                    const rect = logoEl.getBoundingClientRect();
                    const currentSize = (rect.height / window.innerHeight) * 100 - 5;

                    galaxiaMaskEl.style.webkitMaskSize = `auto ${currentSize}vh`;
                    galaxiaMaskEl.style.maskSize = `auto ${currentSize}vh`;
                }
				
            }, 1000) // Iniciar al mismo tiempo que la animación anterior
			// Animación del video para cambiar la reproducción

			// Ocultar el logo al finalizar su segmento
			.add({
				targets: logoEl,
				opacity: [{ value: 0, duration: 1 }]
			}, 1800);
		// #endregion
		// #endregion

		// #region 📹 CONFIGURACIÓN DE VIDEOS - Gestión de reproducción y secuencias
		// --- Sincronización de video con la animación ---
		// Durante el zoom del logo (t=1000->2000ms de la timeline) scrubbear 0-2s de empezar.mp4
		// Al terminar el zoom, continuar reproduciendo empezar.mp4 hasta el final
		// Luego alternar loopinversed.mp4 y loop.mp4 en bucle

	const ZOOM_START_MS = 1000;
	const ZOOM_END_MS = 2000;
	const SCRUB_DURATION_S = 2; // primeros 2 segundos

		// Usar nombres reales del repo
	const VIDEO_INTRO = '/vid/empezar.mp4';
	const PLAYLIST = ['/vid/loopinversed.mp4', '/vid/loop.mp4'];
	let playlistIndex = 0;
	let isScrollScrubActive = true;
	let afterZoomPlaybackStarted = false;
	let activeMetadataReady = false;
	let playlistStarted = false;

	// Doble buffer de video
	let activeVideo = videoA;
	let bufferVideo = videoB;

	// Detectar si es dispositivo móvil
	const isMobileDevice = window.matchMedia('(max-width: 768px)').matches;
	
	// #region 🎞️ SECUENCIAS AVIF - Configuración de frames para animación fluida
	// Secuencia de frames AVIF en canvas para el tramo de zoom (30fps móvil, 60fps PC)
	const SEQ_FPS = isMobileDevice ? 30 : 60;
	const SEQ_DURATION_S = 2;
	let TOTAL_FRAMES = Math.floor(SEQ_FPS * SEQ_DURATION_S); // 60 frames (móvil) o 120 frames (PC)
	const FRAME_BASE = '/vid/empezar/';
	let FRAME_EXT = 'avif';
	let frameStartIndex = 0; // detectaremos 0 o 1 según exportación
	let padWidth = 0; // si los ficheros usan ceros a la izquierda (ej: 000.avif)
	const imagesCache = [];
	const ctx = seqCanvas.getContext('2d');
	let lastDrawnIndex = -1;
	let sequenceActive = false;

	// #region 🔧 UTILIDADES DE FRAMES
	function padNum(i) {
		// Si todavía no se ha detectado padWidth, asumimos por defecto 3 dígitos
		const effectivePad = (padWidth && padWidth > 0) ? padWidth : 3;
		if (!effectivePad || effectivePad <= 1) return String(i);
		return String(i).padStart(effectivePad, '0');
	}

	// Mapeo de frames: seleccionar cada 4to frame (móvil 30fps) o cada 2do frame (PC 60fps)
	const FRAME_SKIP = isMobileDevice ? 4 : 2; // 120fps / 30fps = 4, 120fps / 60fps = 2
	
	function getActualFrameIndex(logicalIndex) {
		// Mapear del índice lógico al índice real en la secuencia
		// Móvil (30fps): 0..59 → 0..236, PC (60fps): 0..119 → 0..238
		return frameStartIndex + (logicalIndex * FRAME_SKIP);
	}

	function frameSrc(logicalIndex) { 
		const actualIndex = getActualFrameIndex(logicalIndex);
		return `${FRAME_BASE}${padNum(actualIndex)}.${FRAME_EXT}`; 
	}
	// #endregion

	// #region 🖼️ FUNCIONES DE CANVAS - Renderizado y gestión de imágenes
	function resizeCanvas() {
		const rect = galaxiaMaskEl.getBoundingClientRect();
		const ratio = window.devicePixelRatio || 1;
		seqCanvas.width = Math.max(1, Math.floor(rect.width * ratio));
		seqCanvas.height = Math.max(1, Math.floor(rect.height * ratio));
		seqCanvas.style.width = '100%';
		seqCanvas.style.height = '100%';
	}

	function drawImageCover(img) {
		if (!img || !ctx) return;
		const cw = seqCanvas.width;
		const ch = seqCanvas.height;
		const iw = img.naturalWidth;
		const ih = img.naturalHeight;
		if (!iw || !ih || !cw || !ch) return;
		const scale = Math.max(cw / iw, ch / ih);
		const nw = iw * scale;
		const nh = ih * scale;
		const dx = (cw - nw) / 2;
		const dy = (ch - nh) / 2;
		ctx.clearRect(0, 0, cw, ch);
		ctx.drawImage(img, dx, dy, nw, nh);
	}

	function loadFrame(i) {
		if (imagesCache[i]) return imagesCache[i];
		const img = new Image();
		img.decoding = 'async';
		img.src = frameSrc(i);
		imagesCache[i] = new Promise((resolve) => {
			const done = () => resolve(img);
			img.onload = done; img.onerror = done;
			if (img.decode) { img.decode().then(done).catch(done); }
		});
		return imagesCache[i];
	}
	// #endregion

	// #region 🔍 DETECCIÓN DE FRAMES - Auto-detección de formato y rango disponible
	async function detectFrameRange() {
		// Probar si la secuencia comienza en 0 o en 1
		function test(src) {
			return new Promise((resolve) => {
				const img = new Image();
				img.onload = () => resolve(true);
				img.onerror = () => resolve(false);
				img.src = src;
			});
		}
		
		function testActualFrame(actualIndex) {
			const src = `${FRAME_BASE}${padNum(actualIndex)}.${FRAME_EXT}`;
			return test(src);
		}
		
		// Detectar extensión disponible: preferir avif → webp → png
		const exts = ['avif', 'webp', 'png'];
		for (const ext of exts) {
			// Para cada extensión, averiguar si hay archivos con padding (3,2,1) o sin padding
			let found = false;
			for (const w of [3,2,1,0]) {
				const candidate = FRAME_BASE + (w > 0 ? String(0).padStart(w,'0') : '0') + `.${ext}`;
				if (await test(candidate)) { FRAME_EXT = ext; padWidth = w; found = true; break; }
				// también probar el siguiente índice (1) por si empieza en 1
				const candidate1 = FRAME_BASE + (w > 0 ? String(1).padStart(w,'0') : '1') + `.${ext}`;
				if (await test(candidate1)) { FRAME_EXT = ext; padWidth = w; found = true; break; }
			}
			if (found) break;
		}
		
		// Ahora probar existencia real de los frames usando el mapeo
		const hasZero = await testActualFrame(0);
		if (hasZero) { frameStartIndex = 0; }
		else {
			const hasOne = await testActualFrame(1);
			if (hasOne) { frameStartIndex = 1; }
			else { frameStartIndex = 0; }
		}
		
		// Con framerate adaptativo tenemos frames lógicos variables según dispositivo
		// Móvil (30fps): 60 frames lógicos, PC (60fps): 120 frames lógicos
		// Verificar si tenemos suficientes frames en la secuencia original
		const lastLogicalFrame = TOTAL_FRAMES - 1;
		const lastActualFrame = getActualFrameIndex(lastLogicalFrame);
		
		if (await testActualFrame(lastActualFrame)) {
			// Tenemos todos los frames necesarios
			console.log(`Detected ${TOTAL_FRAMES} logical frames (${SEQ_FPS}fps ${isMobileDevice ? 'mobile' : 'desktop'}) mapping to actual frames up to ${lastActualFrame}`);
		} else {
			// Reducir el número de frames si no tenemos suficientes
			let maxFrames = 0;
			for (let i = 0; i < TOTAL_FRAMES; i++) {
				const actualFrame = getActualFrameIndex(i);
				if (await testActualFrame(actualFrame)) {
					maxFrames = i + 1;
				} else {
					break;
				}
			}
			TOTAL_FRAMES = Math.max(1, maxFrames);
			console.log(`Adjusted to ${TOTAL_FRAMES} logical frames due to limited actual frames`);
		}
	}

	function primePreload() {
		// Precargar frames iniciales para fluidez (30 para móvil, 60 para PC)
		const FIRST = 0; // Siempre empezamos en 0 lógico
		const PRELOAD_COUNT = isMobileDevice ? 29 : 59; // Móvil: ~30 frames, PC: ~60 frames
		const LAST = Math.min(TOTAL_FRAMES - 1, PRELOAD_COUNT);
		for (let i = FIRST; i <= LAST; i++) loadFrame(i);
		// Preload del resto en segundo plano
		setTimeout(() => {
			const end = TOTAL_FRAMES - 1;
			for (let i = LAST + 1; i <= end; i++) loadFrame(i);
		}, 500);
	}

	function setSequenceVisible(v) {
		if (v) {
			if (!sequenceActive) {
				sequenceActive = true;
				seqCanvas.style.opacity = '1';
				activeVideo.style.opacity = '0';
				bufferVideo.style.opacity = '0';
			}
		} else {
			if (sequenceActive) {
				sequenceActive = false;
				seqCanvas.style.opacity = '0';
			}
		}
	}

	async function showFrame(index) {
		if (index === lastDrawnIndex) return;
		lastDrawnIndex = index;
		const img = await loadFrame(index);
		if (lastDrawnIndex !== index) return; // Evitar draw desfasado
		drawImageCover(img);
	}

	// Inicializar canvas y precarga
	resizeCanvas();
	window.addEventListener('resize', resizeCanvas);
	// Detectar rango de la secuencia (inicio y total), precargar y pintar primer frame
	detectFrameRange().then(() => {
		primePreload();
		setSequenceVisible(true);
		showFrame(0); // Siempre empezamos en frame lógico 0
	});
	// #endregion
	// #endregion

	// #region 🎮 CONTROL DE REPRODUCCIÓN - Scrubbing y gestión de videos
	// Scheduler de scrubbing para fluidez
	let pendingScrubT = null;
	let scrubRafId = 0;
	let lastScrubbedT = -1;
	const SCRUB_EPS = 0.02; // segundos; evita micro-seeks <20ms

	function applyScrub() {
		scrubRafId = 0;
		if (pendingScrubT == null || !activeMetadataReady) return;
		const t = pendingScrubT;
		pendingScrubT = null;
		// Evitar mover si ya estamos muy cerca
		try {
			const cur = activeVideo.currentTime || 0;
			if (Math.abs(cur - t) < SCRUB_EPS) return;
			if (typeof activeVideo.fastSeek === 'function') {
				activeVideo.fastSeek(t);
			} else {
				activeVideo.currentTime = t;
			}
			lastScrubbedT = t;
		} catch {}
	}

	function scheduleScrub(t) {
		pendingScrubT = t;
		if (!scrubRafId) scrubRafId = requestAnimationFrame(applyScrub);
	}

		function waitForMetadata(el) {
			return new Promise((resolve) => {
				if (el.readyState >= 1 && !isNaN(el.duration)) {
					resolve();
					return;
				}
				const onLoaded = () => {
					el.removeEventListener('loadedmetadata', onLoaded);
					resolve();
				};
				el.addEventListener('loadedmetadata', onLoaded, { once: true });
			});
		}

		async function setVideoSource(el, src, startTime = 0, autoplay = false) {
			try {
				el.loop = false;
				// Cambiar src directamente en el video
				if (el.src !== location.origin + src && el.src !== src) {
					el.src = src;
				}
				// Forzar carga de metadatos
				el.load();
				await waitForMetadata(el);
				if (el === activeVideo) activeMetadataReady = true;
				// Posicionar
				const clampedStart = Math.max(0, Math.min(startTime, (el.duration || Infinity)));
				if (!Number.isNaN(clampedStart)) {
					try { el.currentTime = clampedStart; } catch {}
				}
				if (autoplay) {
					try { await el.play(); } catch {}
				} else {
					el.pause();
				}
			} catch (e) {
				// Silencioso: si falla, no romper la animación
			}
		}

		async function prepareNext(src) {
			// Precargar en el buffer
			await setVideoSource(bufferVideo, src, 0, false);
			// Opcional: priming del decodificador
			try { await bufferVideo.play(); bufferVideo.pause(); } catch {}
		}

		function attachEndedHandler() {
			activeVideo.onended = async () => {
				// Primera vez: venimos del intro
				if (!playlistStarted) {
					playlistStarted = true;
				}
				// Swap al buffer ya precargado
				await swapToPreloaded();
				// Preparar el siguiente en la lista
				playlistIndex = (playlistIndex + 1) % PLAYLIST.length;
				prepareNext(PLAYLIST[playlistIndex]);
			};
			bufferVideo.onended = null;
		}

		async function swapToPreloaded() {
			// Asegurar visible y reproduciendo el buffer antes del swap
			try { bufferVideo.currentTime = 0; } catch {}
			try { await bufferVideo.play(); } catch {}
			bufferVideo.style.opacity = '1';
			// Esperar 2 frames para asegurar un render antes de ocultar el activo
			await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));
			// Ocultar/pausar el activo
			activeVideo.style.opacity = '0';
			try { activeVideo.pause(); } catch {}
			// Intercambiar referencias
			const tmp = activeVideo; activeVideo = bufferVideo; bufferVideo = tmp;
			attachEndedHandler();
		}

		// Preparar el video inicial para scrubbing en el activo y precargar el primero del playlist en el buffer
		setVideoSource(activeVideo, VIDEO_INTRO, 0, false);
		prepareNext(PLAYLIST[playlistIndex]); // playlistIndex === 0 al inicio
		attachEndedHandler();

        function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
		// #endregion

		// #region 📜 MANEJO DE SCROLL - Sincronización de animaciones con scroll
		function onScroll() {
			const scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
			
			const ANIMATION_VH = 2; // configurable
			const viewportHeight = window.innerHeight;
			const start = window._parte2StickyStart;
			let progress;
			if (start != null && document.querySelector('.parte2')?.classList.contains('stuck')) {
				const scrolled = Math.max(0, scrollY - start);
				progress = clamp(scrolled / (ANIMATION_VH * viewportHeight), 0, 1);
			} else {
				// fallback: progreso relativo simple en vh
				progress = clamp(scrollY / (ANIMATION_VH * viewportHeight), 0, 1);
			}

			const seekTime = progress * timeline.duration;

			// Opcional: optimizar con requestAnimationFrame (ver nota más abajo)
			timeline.seek(seekTime);

			// Sincronización del video con el tramo de zoom
			if (isScrollScrubActive) {
				if (seekTime <= ZOOM_START_MS) {
					// Antes del zoom: pausar en 0 y mostrar primer frame
					try { if (!activeVideo.paused) activeVideo.pause(); } catch {}
					setSequenceVisible(true);
					showFrame(0);
				} else if (seekTime < ZOOM_END_MS) {
					// En el zoom: scrubbing 0-2s sobre la secuencia AVIF
					const localP = (seekTime - ZOOM_START_MS) / (ZOOM_END_MS - ZOOM_START_MS);
					const frameIndex = Math.max(0, Math.min(TOTAL_FRAMES - 1, Math.round(localP * (TOTAL_FRAMES - 1))));
					try { if (!activeVideo.paused) activeVideo.pause(); } catch {}
					setSequenceVisible(true);
					showFrame(frameIndex);
				} else {
					// Después del zoom: continuar reproduciendo el intro
					if (!afterZoomPlaybackStarted && activeMetadataReady) {
						afterZoomPlaybackStarted = true;
						isScrollScrubActive = false; // Dejar de scrubbear tras iniciar reproducción continua
						// La 2ª parte del video ya viene recortada: empezar desde 0
						try { activeVideo.currentTime = 0; } catch {}
						try { activeVideo.play(); } catch {}
						activeVideo.style.opacity = '1';
						setSequenceVisible(false);
						// Limpiar scheduler de scrubbing
						pendingScrubT = null;
						if (scrubRafId) { cancelAnimationFrame(scrubRafId); scrubRafId = 0; }
						lastScrubbedT = -1;
					}
				}
			}

			// console.log('scrollY:', scrollY, 'pageRatio:', pageRatio, 'newRatio:', newRatio, 'scale:', scale, 'progress:', progress, 'seekTime:', seekTime);
		}


        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
		// #endregion
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollAnim);
    } else {
        initScrollAnim();
    }
</script>
	<!-- #endregion -->
	<!-- #region 📌 SCRIPT: STICKY PROYECTOS - Control manual de posición fija -->
	<script is:inline>
		(() => {
			const container = document.querySelector('.proyectos-container');
			if (!container) return;

			// Placeholder para evitar salto de layout
			const placeholder = document.createElement('div');
			placeholder.style.width = '100%';
			placeholder.style.display = 'none';
			container.parentNode.insertBefore(placeholder, container.nextSibling);

			const syncPlaceholder = () => {
				placeholder.style.height = `${container.getBoundingClientRect().height}px`;
			};
			syncPlaceholder();
			const ro = new ResizeObserver(syncPlaceholder);
			ro.observe(container);
			window.addEventListener('resize', syncPlaceholder);

			// Sentinel
			const sentinel = document.createElement('div');
			sentinel.setAttribute('aria-hidden', 'true');
			sentinel.style.height = '1px';
			sentinel.style.width = '100%';
			sentinel.style.pointerEvents = 'none';
			container.parentNode.insertBefore(sentinel, container);

			const io = new IntersectionObserver((entries) => {
				const entry = entries[0];
				const rect = sentinel.getBoundingClientRect();
				const rootTop = entry.rootBounds ? entry.rootBounds.top : 0;

				if (entry.isIntersecting) {
					if (container.classList.contains('stuck')) {
						container.classList.remove('stuck');
						placeholder.style.display = 'none';
					}
				} else if (rect.top < rootTop) {
					if (!container.classList.contains('stuck')) {
						container.classList.add('stuck');
						placeholder.style.display = 'block';
					}
				} else {
					if (container.classList.contains('stuck')) {
						container.classList.remove('stuck');
						placeholder.style.display = 'none';
					}
				}
			}, { root: null, threshold: 0 });

			io.observe(sentinel);

			// Check inicial
			if ((window.scrollY ?? window.pageYOffset ?? document.documentElement.scrollTop ?? 0) <= 0) {
				container.classList.remove('stuck');
				placeholder.style.display = 'none';
			}
		})();
	</script>
	<!-- #endregion -->

	<!-- #region 🎬 SCRIPT: ANIMACIONES PROYECTOS -->
	<script type="module">
		import anime from 'https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js';

		document.addEventListener('DOMContentLoaded', () => {
			const section = document.querySelector('.proyectos-section');
			const container = document.querySelector('.proyectos-container');
			const grid = document.querySelector('.proyectos-grid');
			const logo = document.querySelector('.proyectos-logo');
			const detailScreens = document.querySelectorAll('.aptitud-detail-screen');
			
			if (!section || !container || !grid || !logo || detailScreens.length === 0) return;

			const totalAptitudes = detailScreens.length;
			let currentAptitudIndex = -1; // -1 = vista órbita, 0+ = pantalla de aptitud

			// Función para calcular distancia y ángulo entre dos puntos
			function getLineProps(fromX, fromY, toX, toY) {
				const dx = toX - fromX;
				const dy = toY - fromY;
				const distance = Math.sqrt(dx * dx + dy * dy);
				const angle = Math.atan2(dy, dx) * (180 / Math.PI);
				return { distance, angle };
			}

			// Detectar si es móvil para adaptar comportamiento
			const isMobileView = window.matchMedia('(max-width: 768px)').matches;

			// Función auxiliar para calcular posición y ángulo de líneas
			function calculateLineToCard(circleRect, cardRect, circleRadius) {
				// Centro del círculo
				const circleCenterX = circleRect.left + circleRect.width / 2;
				const circleCenterY = circleRect.top + circleRect.height / 2;
				
				// Punto de destino: borde izquierdo de la tarjeta, centrado verticalmente
				const targetX = cardRect.left;
				const targetY = cardRect.top + cardRect.height / 2;
				
				// Calcular ángulo y distancia
				const dx = targetX - circleCenterX;
				const dy = targetY - circleCenterY;
				const angle = Math.atan2(dy, dx) * (180 / Math.PI);
				const totalDistance = Math.sqrt(dx * dx + dy * dy);
				
				// La línea empieza desde el borde del círculo
				const lineLength = totalDistance - circleRadius;
				
				return { angle, lineLength, startOffset: circleRadius };
			}

			// Función para actualizar las líneas de una pantalla (usada en resize y show)
			function updateAptitudLines(screen) {
				if (!screen || isMobileView) return;

				const aptitudCircle = screen.querySelector('.aptitud-circle');
				const linesContainer = screen.querySelector('.lines-to-projects');
				const linesToProjects = screen.querySelectorAll('.line-aptitud-proyecto');
				const projectCards = screen.querySelectorAll('.proyecto-detail-card');
				
				if (!aptitudCircle || !linesContainer) return;

				// 1. Obtener dimensiones del círculo (sin transformaciones)
				// Usamos offsetWidth para obtener el tamaño real del layout
				const circleRadius = aptitudCircle.offsetWidth / 2;
				
				// 2. Obtener posición del círculo
				// Para mayor precisión, reseteamos transformaciones temporalmente si es necesario,
				// pero getBoundingClientRect suele ser suficiente si el layout es estable.
				// Sin embargo, si hay animaciones activas (scale), el rect puede ser incorrecto.
				// Como el círculo está centrado por CSS (top/left 50% + margin), su posición base es estable.
				
				// Truco: Clonar el círculo para medir su posición "ideal" sin transformaciones de animación
				// O simplemente confiar en que el centro es el centro de la pantalla (si el diseño lo respeta)
				// Vamos a medir el elemento real, pero intentando ignorar el scale si es posible.
				// Si el elemento tiene scale(0.5), getBoundingClientRect devuelve la mitad.
				// Solución: Calcular el centro basado en el offsetParent (screen)
				
				const screenRect = screen.getBoundingClientRect();
				
				// El círculo tiene margin-left/top negativos para centrarse.
				// Su centro geométrico debería ser exactamente screenRect.left + screenRect.width/2
				const circleCenterX = screenRect.left + screenRect.width / 2;
				const circleCenterY = screenRect.top + screenRect.height / 2;
				
				// Posicionar el contenedor de líneas en el centro exacto
				linesContainer.style.left = `${screenRect.width / 2}px`;
				linesContainer.style.top = `${screenRect.height / 2}px`;
				
				// 3. Calcular líneas para cada tarjeta
				linesToProjects.forEach((line, i) => {
					const card = projectCards[i];
					if (!card) return;
					
					// Las tarjetas tienen transform: translateX(30px) en CSS inicial o animado.
					// Necesitamos su posición FINAL (translateX 0).
					// Podemos calcularla restando la transformación actual o clonando.
					// Dado que están en un flex container, su posición layout es estable.
					// Vamos a medir su posición y compensar la transformación actual.
					
					const cardRect = card.getBoundingClientRect();
					const style = window.getComputedStyle(card);
					const matrix = new DOMMatrix(style.transform);
					
					// Posición "pura" sin transform (destino final de la animación)
					const cardLeft = cardRect.left - matrix.m41;
					const cardTop = cardRect.top - matrix.m42;
					const cardWidth = cardRect.width; // Asumimos que scale es 1
					const cardHeight = cardRect.height;
					
					// Recalcular target basado en posición limpia
					const targetX = cardLeft;
					const targetY = cardTop + cardHeight / 2;
					
					// Calcular vector desde el centro del círculo
					const dx = targetX - circleCenterX;
					const dy = targetY - circleCenterY;
					
					const angle = Math.atan2(dy, dx) * (180 / Math.PI);
					const totalDistance = Math.sqrt(dx * dx + dy * dy);
					const lineLength = totalDistance - circleRadius;
					
					// Aplicar estilos
					line.style.transform = `rotate(${angle}deg) translateX(${circleRadius}px)`;
					
					// Si la línea ya es visible (animación terminada), actualizamos el ancho
					// Si se está animando, anime.js controla el ancho, pero actualizamos el objetivo si es posible?
					// Anime.js usa valores relativos o absolutos. Si la animación terminó, el width es fijo.
					// Actualizamos el width solo si no es 0 (para no romper la animación de entrada si se redimensiona durante ella)
					if (line.style.width && line.style.width !== '0px') {
						line.style.width = `${Math.max(0, lineLength)}px`;
					}
					
					// Guardamos la longitud calculada en un atributo data para que la animación la use
					line.dataset.targetWidth = Math.max(0, lineLength);
				});
			}

			// Animación de entrada para una pantalla de aptitud
			function showAptitudScreen(index) {
				const screen = detailScreens[index];
				if (!screen) return;

				// Marcar como activa
				screen.classList.add('active');

				const lineLogoAptitud = screen.querySelector('.line-logo-aptitud');
				const aptitudCircle = screen.querySelector('.aptitud-circle');
				const linesContainer = screen.querySelector('.lines-to-projects');
				const linesToProjects = screen.querySelectorAll('.line-aptitud-proyecto');
				const projectCards = screen.querySelectorAll('.proyecto-detail-card');

				// Calcular posiciones iniciales
				updateAptitudLines(screen);

				// Timeline de entrada
				const enterTl = anime.timeline({
					easing: 'easeOutQuad'
				});

				// 1. Fade in screen
				enterTl.add({
					targets: screen,
					opacity: [0, 1],
					duration: 300
				});

				// 2. Línea desde logo hacia aptitud (solo en desktop)
				if (!isMobileView) {
					const logoLineStart = lineLogoAptitud.getBoundingClientRect().left;
					const circleLeft = aptitudCircle.getBoundingClientRect().left; // Esto puede variar con scale, pero para la línea izq está bien
					// Mejor usar el centro calculado
					const screenRect = screen.getBoundingClientRect();
					const circleCenterX = screenRect.left + screenRect.width / 2;
					const circleRadius = aptitudCircle.offsetWidth / 2;
					const circleLeftEdge = circleCenterX - circleRadius;
					
					const logoLineWidth = Math.max(0, circleLeftEdge - logoLineStart);

					enterTl.add({
						targets: lineLogoAptitud,
						width: ['0px', `${logoLineWidth}px`],
						opacity: [0, 1],
						duration: 400
					}, 100);
				}

				// 3. Círculo de aptitud aparece
				enterTl.add({
					targets: aptitudCircle,
					opacity: [0, 1],
					scale: [0.5, 1],
					duration: 400,
					easing: 'easeOutBack'
				}, isMobileView ? 100 : 400);

				// 4. Calcular y posicionar líneas hacia cada tarjeta (solo en desktop)
				const linesDelay = isMobileView ? 300 : 650;
				
				if (!isMobileView) {
					linesToProjects.forEach((line, i) => {
						// Usar el ancho calculado previamente
						const targetWidth = line.dataset.targetWidth || 100;
						
						// Animar la línea
						enterTl.add({
							targets: line,
							width: ['0px', `${targetWidth}px`],
							opacity: [0, 1],
							duration: 350,
							easing: 'easeOutQuad'
						}, linesDelay + (i * 80));
					});
				}

				// 5. Tarjetas de proyecto
				const cardsStartDelay = isMobileView ? 400 : (650 + (linesToProjects.length * 80) + 100);
				enterTl.add({
					targets: projectCards,
					opacity: [0, 1],
					translateX: isMobileView ? [0, 0] : [30, 0],
					translateY: isMobileView ? [20, 0] : [0, 0],
					duration: 400,
					delay: anime.stagger(80),
					easing: 'easeOutQuad'
				}, cardsStartDelay);

				return enterTl;
			}

			// Animación de salida para una pantalla de aptitud
			function hideAptitudScreen(index) {
				const screen = detailScreens[index];
				if (!screen) return Promise.resolve();

				return new Promise((resolve) => {
					const exitTl = anime.timeline({
						easing: 'easeInQuad',
						complete: () => {
							screen.classList.remove('active');
							resolve();
						}
					});

					const projectCards = screen.querySelectorAll('.proyecto-detail-card');
					const linesToProjects = screen.querySelectorAll('.line-aptitud-proyecto');
					const aptitudCircle = screen.querySelector('.aptitud-circle');
					const lineLogoAptitud = screen.querySelector('.line-logo-aptitud');

					// Salida en orden inverso
					exitTl.add({
						targets: projectCards,
						opacity: [1, 0],
						translateX: isMobileView ? [0, 0] : [0, -30],
						translateY: isMobileView ? [0, -20] : [0, 0],
						duration: 300,
						delay: anime.stagger(40, { direction: 'reverse' })
					});

					// Animar cada línea individualmente (solo en desktop)
					if (!isMobileView) {
						linesToProjects.forEach((line, i) => {
							const currentWidth = line.style.width || '0px';
							exitTl.add({
								targets: line,
								width: [currentWidth, '0px'],
								opacity: [1, 0],
								duration: 250
							}, 200 + (i * 30));
						});
					}

					exitTl.add({
						targets: aptitudCircle,
						opacity: [1, 0],
						scale: [1, 0.5],
						duration: 300
					}, isMobileView ? 200 : 350);

					// Línea logo-aptitud solo en desktop
					if (!isMobileView) {
						const logoLineStart = lineLogoAptitud.getBoundingClientRect().left;
						const circleLeft = aptitudCircle.getBoundingClientRect().left;
						const logoLineWidth = Math.max(0, circleLeft - logoLineStart);

						exitTl.add({
							targets: lineLogoAptitud,
							width: [`${logoLineWidth}px`, '0px'],
							opacity: [1, 0],
							duration: 300
						}, 450);
					}

					exitTl.add({
						targets: screen,
						opacity: [1, 0],
						duration: 200
					}, 600);
				});
			}

			// Timeline principal para la transición órbita -> primera aptitud
			const mainTimeline = anime.timeline({
				autoplay: false,
				easing: 'linear',
				duration: 1000
			});

			// Calcular desplazamiento del logo según pantalla
			const isMobile = window.matchMedia('(max-width: 768px)').matches;
			const logoTranslation = isMobile ? 0 : -280;

			mainTimeline
				// Ocultar órbita PRIMERO (el logo NO se mueve aún)
				.add({
					targets: grid,
					opacity: [1, 0],
					scale: [1, 0.5],
					duration: 500,
					easing: 'easeOutQuad'
				})
				// Mover logo hacia la izquierda DESPUÉS de que la órbita desaparezca
				.add({
					targets: logo,
					translateX: [0, logoTranslation],
					scale: [1, 0.85],
					duration: 500,
					easing: 'easeOutQuad'
				}, 500); // Empezar después de que termine la órbita

			// Control de scroll con múltiples fases
			// Fase 0: Transición órbita -> primera aptitud (10% del scroll)
			// Fase 1-N: Cada aptitud ocupa un segmento igual del 90% restante

			const ORBIT_PHASE_RATIO = 0.10; // 10% para la transición inicial (más rápido)
			const aptitudPhaseRatio = (1 - ORBIT_PHASE_RATIO) / totalAptitudes;

			function onScroll() {
				const rect = section.getBoundingClientRect();
				const viewportHeight = window.innerHeight;
				const totalScrollHeight = section.offsetHeight - viewportHeight;
				
				let progress = 0;
				if (rect.top <= 0) {
					const scrolled = Math.abs(rect.top);
					progress = Math.min(1, Math.max(0, scrolled / totalScrollHeight));
				}

				// Fase de transición órbita
				if (progress <= ORBIT_PHASE_RATIO) {
					const orbitProgress = progress / ORBIT_PHASE_RATIO;
					mainTimeline.seek(orbitProgress * mainTimeline.duration);
					
					// Si estamos en una aptitud, ocultarla
					if (currentAptitudIndex >= 0) {
						hideAptitudScreen(currentAptitudIndex);
						currentAptitudIndex = -1;
					}
				} else {
					// Asegurar que la timeline principal esté completa
					mainTimeline.seek(mainTimeline.duration);
					
					// Calcular qué aptitud mostrar
					const aptitudProgress = (progress - ORBIT_PHASE_RATIO) / (1 - ORBIT_PHASE_RATIO);
					const newAptitudIndex = Math.min(
						totalAptitudes - 1,
						Math.floor(aptitudProgress * totalAptitudes)
					);

					// Cambiar de aptitud si es necesario
					if (newAptitudIndex !== currentAptitudIndex) {
						// Ocultar la actual
						if (currentAptitudIndex >= 0) {
							hideAptitudScreen(currentAptitudIndex);
						}
						// Mostrar la nueva
						currentAptitudIndex = newAptitudIndex;
						showAptitudScreen(currentAptitudIndex);
					}
				}
			}

			window.addEventListener('scroll', onScroll, { passive: true });
			
			// Listener para redimensionamiento
			window.addEventListener('resize', () => {
				if (currentAptitudIndex >= 0 && !isMobileView) {
					const screen = detailScreens[currentAptitudIndex];
					updateAptitudLines(screen);
				}
			});
			
			onScroll();
		});
	</script>
	<!-- #endregion -->
</Layout>