---
import Layout from '../layouts/Layout.astro';
import './_styles.css';
import '../styles/proyectos.css';
import '../styles/contacto.css';
import { Image } from 'astro:assets';
//import pgscom from '../assets/pgscom.png';
import minimal1 from '../assets/minimal1.svg';
import customShape from '../assets/custom-shape.svg';
import minimal3 from '../assets/minimal3.svg';
import logo from '../assets/logo.png';
// import logosvganim from '../assets/animlogo/logo.svg';

import proyectosData from '../data/proyectos.json';
import contactoData from '../data/contacto.json';
---

<!-- Cloudflare Turnstile -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<Layout>
	<!--div class="sky-image">
		<a href="/">
			<Image src={logo} height={70} alt="Logo PGSCOM" />
		</a>
	</div-->
	<main class="main-container">
		<div class="particles">
			<Image src={minimal1} alt="" class="particle particle-1" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-2" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-3" width={100} height={100} />
			<Image src={minimal1} alt="" class="particle particle-4" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-5" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-6" width={100} height={100} />
		</div>
		<div class="content">
			<h1 id="animated-text" class="logo-text">PGSCOM</h1>
		</div>
	</main>

	<div class="image-container">
		<!--Image 
			src={pgscom} 
			alt="PGSCOM Character" 
			class="fotopgs" 
			width={2617} 
			height={3490} 
			loading="eager" 
			widths={[320, 640, 1280, 2617]}
			sizes="(max-width: 768px) 100vw, 50vw"
		/-->
	</div>

	<section class="parte2-wrapper">
		<div class="parte2">
			<div class="galaxiamask">
				<video muted playsinline preload="auto" id="video-galaxia-a" class="video-galaxia" style="opacity: 1;"></video>
				<video muted playsinline preload="auto" id="video-galaxia-b" class="video-galaxia" style="opacity: 0;"></video>
			</div>
			<img id="logoanimar" style="width: auto; height: 32.3%;" src="/assets/animlogo/logo.svg" alt="" />
		</div>

	<div style="height: 120vh; display: flex; align-items: center; justify-content: center; position: relative; z-index: 60;"></div>

	<section class="proyectos-section" id="proyectos">
		<div class="proyectos-header">
			<h2 class="proyectos-titulo-seccion">Proyectos</h2>
			<p class="proyectos-subtitulo-seccion">Explora mis trabajos por categoría</p>
		</div>

		<div class="proyectos-hero">
			<div class="proyectos-hero-inner">
				<div class="proyectos-grid">
					{proyectosData.map((aptitud) => (
						<a href={`#aptitud-${aptitud.id}`} class="proyecto-card" data-aptitud-id={aptitud.id}>
							<div class="proyecto-card-inner">
								<div class="proyecto-icon">
									<img src={aptitud.logo} alt={aptitud.titulo} />
								</div>
								<span class="proyecto-titulo">{aptitud.titulo}</span>
							</div>
						</a>
					))}
				</div>
				<div class="proyectos-logo">
					<Image 
						src={logo} 
						alt="PGSCOM Logo" 
						width={720} 
						height={720} 
						widths={[200, 400, 720]}
						sizes="(max-width: 768px) 150px, 200px"
					/>
				</div>
			</div>
		</div>

		<div class="proyectos-content">
			{proyectosData.map((aptitud) => (
				<div class="aptitud-bloque" id={`aptitud-${aptitud.id}`}>
					<div class="aptitud-header">
						<div class="aptitud-icono">
							<img src={aptitud.logo} alt={aptitud.titulo} />
						</div>
						<div class="aptitud-info">
							<h3 class="aptitud-titulo">{aptitud.titulo}</h3>
							<p class="aptitud-descripcion">{aptitud.descripcion}</p>
						</div>
					</div>
				<div class="proyectos-grid-list">
					{aptitud.proyectos && aptitud.proyectos.map((proyecto) => (
						<div 
							class="proyecto-detail-card" 
							data-proyecto-id={proyecto.id}
							data-tiene-contenido={proyecto.contenido ? "true" : "false"}
						>
							<div class="proyecto-image-container">
								<img src={proyecto.imagen} alt={proyecto.titulo} class="proyecto-image" />
								
								{proyecto.link && (
									<a href={proyecto.link} target="_blank" rel="noopener noreferrer" class="card-btn-link-float" title="Visitar proyecto" onclick="event.stopPropagation();">
										<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
											<polyline points="15 3 21 3 21 9"></polyline>
										</svg>
									</a>
								)}
							</div>

							<div class="proyecto-info-wrapper">
								<div class="proyecto-info">
									<h4 class="proyecto-detail-titulo">{proyecto.titulo}</h4>
									{proyecto.descripcion && (
										<p class="proyecto-detail-desc">{proyecto.descripcion}</p>
									)}
								</div>
								
								{proyecto.tecnologias && (
									<div class="proyecto-tecnologias">
										{proyecto.tecnologias.slice(0, 4).map((tech) => (
											<span class="tech-tag" data-tech={tech}>{tech}</span>
										))}
										{proyecto.tecnologias.length > 4 && (
											<span class="tech-tag tech-tag-more">+{proyecto.tecnologias.length - 4}</span>
										)}
									</div>
								)}
							</div>
						</div>
					))}
				</div>
				</div>
			))}
		</div>
	</section>

	<!-- Modal de proyecto -->
	<div class="proyecto-modal-overlay" id="proyectoModal">
		<div class="proyecto-modal">
			<button class="modal-close" id="modalClose" aria-label="Cerrar modal">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
			
			<div class="modal-backdrop">
				<img class="modal-backdrop-img" id="modalBackdrop" src="" alt="" />
			</div>
			
			<div class="modal-content-wrapper">
				<div class="modal-hero">
					<div class="modal-poster-container">
						<img class="modal-poster" id="modalPoster" src="" alt="" />
					</div>
					<div class="modal-hero-info">
						<h1 class="modal-titulo" id="modalTitulo"></h1>
						<div class="modal-meta" id="modalMeta"></div>
						<p class="modal-tagline" id="modalTagline"></p>
						<div class="modal-actions">
							<a href="#" target="_blank" rel="noopener noreferrer" class="modal-btn-primary" id="modalLink" style="display: none;">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
									<polygon points="5 3 19 12 5 21 5 3"></polygon>
								</svg>
								<span>Visitar proyecto</span>
							</a>
							<button class="modal-btn-secondary" id="modalShare" title="Compartir">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="18" cy="5" r="3"></circle>
									<circle cx="6" cy="12" r="3"></circle>
									<circle cx="18" cy="19" r="3"></circle>
									<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
									<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
								</svg>
							</button>
						</div>
					</div>
				</div>
				
				<div class="modal-body">
					<div class="modal-description">
						<p class="modal-description-text" id="modalDescripcion"></p>
					</div>
					<div class="modal-tecnologias" id="modalTecnologias"></div>
					<div class="modal-contenido" id="modalContenido"></div>
				</div>
			</div>
		</div>
	</div>
	</section>

	<section class="contacto-section">
		<div class="contacto-wrapper">
			<div class="contacto-particles">
				<div class="particle-space"></div>
				<div class="particle-space"></div>
				<div class="particle-space"></div>
				<div class="particle-space"></div>
				<div class="particle-space"></div>
			</div>

			<div class="contacto-container">
				<div class="contacto-header">
					<h2 class="contacto-titulo">Contacto</h2>
					<p class="contacto-subtitulo">¿Tienes un proyecto en mente? ¡Hablemos!</p>
				</div>

				<div class="contacto-grid">
					<div class="contacto-info">
						{contactoData.informacion.email && (
							<div class="info-card">
								<div class="info-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
										<polyline points="22,6 12,13 2,6"></polyline>
									</svg>
								</div>
								<div class="info-content">
									<h3>Email</h3>
									<a href={`mailto:${contactoData.informacion.email}`}>{contactoData.informacion.email}</a>
								</div>
							</div>
						)}

						<div class="social-links">
							<h3>Sígueme en redes</h3>
							<div class="social-icons">
								{contactoData.redes.map((red) => (
									<a href={red.url} target="_blank" rel="noopener noreferrer" class="social-icon" title={red.nombre}>
										<span class="sr-only">{red.nombre}</span>
										<img src={red.icono} alt={red.nombre} width="24" height="24" />
									</a>
								))}
							</div>
						</div>
					</div>

					<!-- Contacto -->
					<div class="contacto-form-container">
						<form class="contacto-form" id="contactForm">
							<div class="form-group">
								<label for="nombre">Nombre</label>
								<input 
									type="text" 
									id="nombre" 
									name="nombre" 
									placeholder="Tu nombre completo"
									required
								/>
								<span class="input-border"></span>
							</div>

							<div class="form-group">
								<label for="email">Email</label>
								<input 
									type="email" 
									id="email" 
									name="email" 
									placeholder="manolo@gmail.com"
									required
								/>
								<span class="input-border"></span>
							</div>

							<div class="form-group">
								<label for="asunto">Asunto</label>
								<input 
									type="text" 
									id="asunto" 
									name="asunto" 
									placeholder="¿De qué se trata?"
									required
								/>
								<span class="input-border"></span>
							</div>

							<div class="form-group">
								<label for="mensaje">Mensaje</label>
								<textarea 
									id="mensaje" 
									name="mensaje" 
									placeholder="Cuéntame sobre tu proyecto..."
									rows="5"
									required
								></textarea>
								<span class="input-border"></span>
							</div>

							<!-- Cloudflare Turnstile -->
							<div class="cf-turnstile" data-sitekey="0x4AAAAAACGiv6Et8KLomzvb" data-theme="dark"></div>

							<button type="submit" class="submit-btn">
								<span class="btn-text">Enviar mensaje</span>
								<span class="btn-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<line x1="22" y1="2" x2="11" y2="13"></line>
										<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
									</svg>
								</span>
							</button>

							<div class="form-status" id="formStatus"></div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Órbita de proyectos -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const container = document.querySelector('.proyectos-section .proyectos-hero');
			if (!container) return;

			const cards = Array.from(container.querySelectorAll('.proyecto-card'));
			if (cards.length === 0) return;

			const TWO_PI = Math.PI * 2;
			const REV_SECONDS = 90;
			const DEFAULT_SPEED = TWO_PI / REV_SECONDS;
			const SMOOTH_TAU_STOP = 0.22;
			const SMOOTH_TAU_START = 0.35;

			let angle = 0;
			let speed = 0; // empieza en 0, arranca cuando es visible
			let targetSpeed = DEFAULT_SPEED;
			let lastT = performance.now();
			let running = false;

			const baseAngles = cards.map((_, i) => (TWO_PI * i) / cards.length);

			let cachedRadius = 350;
			const readRadius = () => cachedRadius;

			const updateRadius = () => {
				const raw = getComputedStyle(container).getPropertyValue('--orbit-radius').trim();
				const r = parseFloat(raw);
				cachedRadius = isFinite(r) ? r : 350;
			};
			updateRadius();
			const ro = new ResizeObserver(updateRadius);
			ro.observe(container);

			const setPaused = (paused) => {
				targetSpeed = paused ? 0 : DEFAULT_SPEED;
			};

			let pointerActive = false;
			let pointerX = 0;
			let pointerY = 0;
			let hoverOffAt = 0;
			const HOVER_RELEASE_DELAY_MS = 140;

			container.addEventListener('pointerenter', (e) => {
				pointerActive = true;
				pointerX = e.clientX;
				pointerY = e.clientY;
			});
			container.addEventListener('pointermove', (e) => {
				pointerActive = true;
				pointerX = e.clientX;
				pointerY = e.clientY;
			});
			container.addEventListener('pointerleave', () => {
				pointerActive = false;
				hoverOffAt = 0;
				setPaused(false);
			});

			let lastHoverCheck = 0;

			const tick = (t) => {
				const dt = Math.min(0.05, Math.max(0.001, (t - lastT) / 1000));
				lastT = t;

				if (pointerActive && t - lastHoverCheck > 80) {
					lastHoverCheck = t;
					const el = document.elementFromPoint(pointerX, pointerY);
					const isOnCard = !!(el && container.contains(el) && el.closest('.proyecto-card'));
					if (isOnCard) {
						hoverOffAt = 0;
						setPaused(true);
					} else {
						if (!hoverOffAt) hoverOffAt = t;
						if (t - hoverOffAt > HOVER_RELEASE_DELAY_MS) setPaused(false);
					}
				}

				const tau = (targetSpeed < speed) ? SMOOTH_TAU_STOP : SMOOTH_TAU_START;
				speed += (targetSpeed - speed) * (1 - Math.exp(-dt / tau));
				angle += speed * dt;

				const r = cachedRadius;
				const cosA = Math.cos(angle);
				const sinA = Math.sin(angle);
				// Pre-compute per-card transforms
				for (let i = 0; i < cards.length; i++) {
					const a = angle + baseAngles[i];
					const deg = (a * 180) / Math.PI;
					cards[i].style.transform = `translate(-50%, -50%) rotate(${deg}deg) translateX(${r}px) rotate(${-deg}deg)`;
				}

				requestAnimationFrame(tick);
			};

			// Arranca al mostrarse
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting && !running) {
						running = true;
						lastT = performance.now();
						requestAnimationFrame(tick);
						observer.disconnect();
					}
				});
			}, { threshold: 0.2 });

			observer.observe(container);
		});
	</script>

	<!-- Rotación de tipografías -->
	<script is:inline defer>
		document.addEventListener('DOMContentLoaded', async () => {
			const animatedText = document.getElementById('animated-text');
			
			// Fuentes
			const fonts = [
				'PGSText',
				'Allerta Stencil',
				'Bungee Inline',
				'Chakra Petch',
				'Kranky',
				'Limelight',
				'Meow Script',
				'Modak',
				'Monoton',
				'Offside',
				'Pacifico',
				'Permanent Marker',
				'Rampart One',
				'Solway',
				'Tapestry',
				'Tiny5',
			];
			
			// Tamaño de las fuentes
			const fontSizeFactors = {
				'PGSText': 1.0,
				'Allerta Stencil': 1.0,
				'Bungee Inline': 0.9,
				'Chakra Petch': 1,
				'Kranky': 1.0,
				'Limelight': 0.95,
				'Meow Script': 0.85,
				'Modak': 1.0,
				'Monoton': 0.8,
				'Offside': 1.1,
				'Pacifico': 0.8,
				'Permanent Marker': 1.0,
				'Rampart One': 0.8,
				'Solway': 1.15,
				'Tapestry': 1.05,
				'Tiny5': 1.2,
			};

			// Algunas fuentes no tienen bold, usamos el peso correcto para cada una
			const fontWeights = {
				'PGSText': '400',
				'Solway': '500', 'Chakra Petch': '500',
				'Modak': '400', 'Monoton': '400',
			};

			const baseFontSize = 7;
			const delay = 5000;
			const fadeDuration = { out: 600, in: 800 };
			
			let currentIndex = 0;
			let fontsLoaded = false;

			function getFontWeight(name) {
				return fontWeights[name] || 'bold';
			}

			async function preloadFonts() {
				try {
					if ('fonts' in document) {
						await Promise.all(fonts.map(name =>
							document.fonts.load(`${getFontWeight(name)} 5rem "${name}"`)
						));
					} else {
						const wrapper = document.createElement('div');
						wrapper.style.cssText = 'position:absolute;visibility:hidden;font-size:5rem';
						document.body.appendChild(wrapper);

						await Promise.all(fonts.map(name => new Promise(resolve => {
							const el = document.createElement('span');
							el.textContent = 'PGSCOM';
							el.style.fontFamily = `"${name}", cursive`;
							el.style.fontWeight = getFontWeight(name);
							wrapper.appendChild(el);
							setTimeout(() => { wrapper.removeChild(el); resolve(); });
						})));

						document.body.removeChild(wrapper);
					}
				} catch {}
				fontsLoaded = true;
			}

			function applyFont(el, name) {
				el.style.fontFamily = `"${name}", cursive`;
				el.style.fontWeight = getFontWeight(name);
				const factor = fontSizeFactors[name] || 1.0;
				let size = baseFontSize * factor;
				if (window.matchMedia('(max-width: 768px)').matches) size *= 2;
				el.style.fontSize = `${size}cqw`;
			}

			function changeFont() {
				if (!fontsLoaded) return;
				const el = window.animatedText;

				el.classList.add('fade-out');

				setTimeout(() => {
					currentIndex = (currentIndex + 1) % fonts.length;
					applyFont(el, fonts[currentIndex]);

					el.classList.remove('fade-out');
					el.classList.add('fade-in');

					setTimeout(() => el.classList.remove('fade-in'), fadeDuration.in);
				}, fadeDuration.out);
			}

			applyFont(animatedText, fonts[0]);
			animatedText.classList.add('loading');

			await preloadFonts();

			animatedText.classList.remove('loading');
			animatedText.classList.add('loaded');

			window.animatedText = animatedText;
			setInterval(changeFont, delay);
		});
	</script>

	<!-- Scroll + vídeo galaxia -->
	<script>
		import '../scripts/galaxia-scroll.js';
	</script>

	<!-- Formulario de contacto -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const form       = document.getElementById('contactForm');
			const formStatus = document.getElementById('formStatus');
			if (!form || !formStatus) return;

			const formGroups = form.querySelectorAll('.form-group');
			formGroups.forEach((group, i) => {
				group.style.opacity = '0';
				group.style.transform = 'translateY(20px)';
				setTimeout(() => {
					group.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
					group.style.opacity = '1';
					group.style.transform = 'translateY(0)';
				}, i * 100);
			});

			function showStatus(msg, type) {
				formStatus.textContent = msg;
				formStatus.className = `form-status show ${type}`;
				setTimeout(() => formStatus.classList.remove('show'), 5000);
			}

			const inputs = form.querySelectorAll('input, textarea');
			inputs.forEach(input => {
				input.addEventListener('blur', function() {
					if (this.value.trim() === '' && this.hasAttribute('required')) {
						this.style.borderColor = 'rgba(239, 68, 68, 0.6)';
					} else if (this.type === 'email' && this.value.trim()) {
						const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.value);
						this.style.borderColor = valid ? 'rgba(34, 197, 94, 0.6)' : 'rgba(239, 68, 68, 0.6)';
					} else if (this.value.trim()) {
						this.style.borderColor = 'rgba(34, 197, 94, 0.6)';
					}
				});
				input.addEventListener('focus', function() {
					this.style.borderColor = 'rgba(0, 180, 216, 0.6)';
				});
			});

			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				const data = Object.fromEntries(new FormData(form));

				if (!data.nombre || !data.email || !data.asunto || !data.mensaje) {
					showStatus('⚠️ Por favor, completa todos los campos', 'error');
					return;
				}
				if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
					showStatus('⚠️ Por favor, ingresa un email válido', 'error');
					return;
				}
				if (!data['cf-turnstile-response']) {
					showStatus('⚠️ Verificación de seguridad fallida. Por favor, recarga la página.', 'error');
					return;
				}

				const submitBtn = form.querySelector('.submit-btn');
				const btnText   = submitBtn.querySelector('.btn-text');
				const original  = btnText.textContent;
				submitBtn.disabled    = true;
				btnText.textContent   = 'Enviando...';
				submitBtn.style.opacity = '0.7';

				try {
					const resp = await fetch('/contact', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({
							nombre:  data.nombre,
							email:   data.email,
							asunto:  data.asunto,
							mensaje: data.mensaje,
							'cf-turnstile-response': data['cf-turnstile-response'],
						}),
					});

					const json = await resp.json().catch(() => ({ ok: false }));
					if (!resp.ok || !json.ok) throw new Error(json.error || 'Error en el servidor');

					showStatus('✨ ¡Mensaje enviado con éxito! Te responderé pronto.', 'success');
					form.reset();
					inputs.forEach(input => { input.style.borderColor = 'rgba(0, 180, 216, 0.2)'; });
				} catch (err) {
					showStatus('❌ Error al enviar el mensaje. Inténtalo nuevamente.', 'error');
				} finally {
					submitBtn.disabled  = false;
					btnText.textContent = original;
					submitBtn.style.opacity = '1';
				}
			});

			let interactionCount = 0;
			form.addEventListener('input', () => {
				if (++interactionCount % 5 !== 0) return;
				const sparkle = document.createElement('div');
				sparkle.style.cssText = 'position:absolute;width:4px;height:4px;background:#48cae4;border-radius:50%;pointer-events:none;box-shadow:0 0 10px #48cae4';
				const rect = form.getBoundingClientRect();
				sparkle.style.left = `${Math.random() * rect.width}px`;
				sparkle.style.top  = `${Math.random() * rect.height}px`;
				form.appendChild(sparkle);
				setTimeout(() => {
					sparkle.style.transition = 'transform 1s ease-out, opacity 1s ease-out';
					sparkle.style.transform  = `translateY(-${Math.random() * 50 + 20}px)`;
					sparkle.style.opacity    = '0';
				}, 10);
				setTimeout(() => sparkle.remove(), 1100);
			});
		});
	</script>

	<!-- Modal de proyectos -->
	<script define:vars={{ proyectosData }}>
		document.addEventListener('DOMContentLoaded', () => {
			const modal          = document.getElementById('proyectoModal');
			const modalClose     = document.getElementById('modalClose');
			const modalTitulo    = document.getElementById('modalTitulo');
			const modalBackdrop  = document.getElementById('modalBackdrop');
			const modalPoster    = document.getElementById('modalPoster');
			const modalMeta      = document.getElementById('modalMeta');
			const modalTagline   = document.getElementById('modalTagline');
			const modalDescripcion  = document.getElementById('modalDescripcion');
			const modalTecnologias  = document.getElementById('modalTecnologias');
			const modalContenido    = document.getElementById('modalContenido');
			const modalLink      = document.getElementById('modalLink');
			const modalShare     = document.getElementById('modalShare');

			function findProyecto(id) {
				for (const aptitud of proyectosData) {
					const proyecto = aptitud.proyectos.find(p => p.id === id);
					if (proyecto) return { proyecto, aptitud };
				}
				return null;
			}

			function openModal(id) {
				const result = findProyecto(id);
				if (!result) return;
				const { proyecto, aptitud } = result;

				modalTitulo.textContent = proyecto.titulo;

				modalBackdrop.src = proyecto.imagenFondo || proyecto.imagen;
				modalBackdrop.alt = proyecto.titulo;
				modalPoster.src   = proyecto.imagen;
				modalPoster.alt   = proyecto.titulo;

				let metaHTML = `<span class="modal-meta-item">${aptitud.titulo}</span>`;
				if (proyecto.premio) metaHTML += `<span class="modal-meta-badge">🏆 ${proyecto.premio}</span>`;
				if (proyecto.tecnologias?.length) metaHTML += `<span class="modal-meta-item">${proyecto.tecnologias.length} tecnologías</span>`;
				modalMeta.innerHTML = metaHTML;

				modalTagline.textContent = proyecto.descripcion || '';

				if (proyecto.descripcion) {
					modalDescripcion.textContent = proyecto.descripcion;
					modalDescripcion.parentElement.style.display = 'block';
				} else {
					modalDescripcion.parentElement.style.display = 'none';
				}

				modalTecnologias.innerHTML = proyecto.tecnologias
					? proyecto.tecnologias.map(t => `<span class="modal-tech-tag">${t}</span>`).join('')
					: '';

				if (proyecto.contenido) {
					modalContenido.innerHTML = proyecto.contenido;
					modalContenido.style.display = 'block';
				} else {
					modalContenido.innerHTML = '';
					modalContenido.style.display = 'none';
				}

				if (proyecto.link) {
					modalLink.href = proyecto.link;
					modalLink.style.display = 'inline-flex';
				} else {
					modalLink.style.display = 'none';
				}

				modal.classList.add('active');
			}

			function closeModal() {
				modal.classList.remove('active');
				document.body.style.overflow = '';
			}

			modalShare?.addEventListener('click', async () => {
				if (navigator.share) {
					try {
						await navigator.share({ title: modalTitulo.textContent, text: `Mira este proyecto: ${modalTitulo.textContent}`, url: window.location.href });
					} catch {}
				} else {
					navigator.clipboard.writeText(window.location.href);
					alert('URL copiada al portapapeles');
				}
			});

			document.querySelectorAll('.proyecto-detail-card').forEach(card => {
				card.addEventListener('click', (e) => {
					if (e.target.closest('.card-btn-link-float')) return;
					openModal(card.dataset.proyectoId);
				});
			});

			modalClose?.addEventListener('click', closeModal);
			modal?.addEventListener('click', (e) => {
				if (e.target === modal || e.target.classList.contains('modal-backdrop')) closeModal();
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && modal.classList.contains('active')) closeModal();
			});
		});
	</script>
</Layout>