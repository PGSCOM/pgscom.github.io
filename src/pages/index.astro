---
import Layout from '../layouts/Layout.astro';
import './_styles.css';
import { Image } from 'astro:assets';
import pgscom from '../assets/pgscom.png';
import minimal1 from '../assets/minimal1.svg';
import customShape from '../assets/custom-shape.svg';
import minimal3 from '../assets/minimal3.svg';
import logo from '../assets/logo.png';
import logosvganim from '../assets/animlogo/logo.svg';
---

<Layout>
	<!--div class="sky-image">
		<a href="/">
			<Image src={logo} height={70} alt="Logo PGSCOM" />
		</a>
	</div-->
	<main class="main-container">
		<div class="particles">
			<Image src={minimal1} alt="" class="particle particle-1" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-2" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-3" width={100} height={100} />
			<Image src={minimal1} alt="" class="particle particle-4" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-5" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-6" width={100} height={100} />
		</div>
		<div class="content">
			<h1 id="animated-text" class="logo-text">PGSCOM</h1>
		</div>
	</main>

	<div class="image-container">
		<Image src={pgscom} alt="PGSCOM Character" class="fotopgs" width={2617} height={3490} loading="eager" />
	</div>

	<!-- Div que ocupa el 100% de la pantalla que contiene el logo en el centro -->
	<div class="parte2">
		<div class="galaxiamask">
			<!-- Video Galaxia bucle -->
			<canvas id="galaxia-seq" class="video-galaxia" style="opacity:0;"></canvas>
			<video muted playsinline preload="auto" id="video-galaxia-a" class="video-galaxia"></video>
			<video muted playsinline preload="auto" id="video-galaxia-b" class="video-galaxia" style="opacity:0;"></video>
		</div>
		<img id="logoanimar" style="width: auto; height: 32.3%;" src={logosvganim.src} alt="" />
		<!-- El width sería 18% (698/3840) y el height sería 32.3% (698/2160) -->
	</div>

	<script is:inline>
		// Optimizado con IntersectionObserver (sin listeners de scroll) + ResizeObserver.
		(() => {
			const parte = document.querySelector('.parte2');
			if (!parte) return;

			// Placeholder para evitar salto cuando .parte2 se fija
			const placeholder = document.createElement('div');
			placeholder.style.width = '100%';
			placeholder.style.display = 'none';
			parte.parentNode.insertBefore(placeholder, parte.nextSibling);

			// Mantener altura del placeholder sincronizada con el elemento
			const syncPlaceholder = () => {
				placeholder.style.height = `${parte.getBoundingClientRect().height}px`;
			};
			syncPlaceholder();
			const ro = new ResizeObserver(syncPlaceholder);
			ro.observe(parte);
			window.addEventListener('resize', syncPlaceholder);

			// Sentinel antes de .parte2 para detectar cruce con el viewport
			const sentinel = document.createElement('div');
			sentinel.setAttribute('aria-hidden', 'true');
			sentinel.style.height = '1px';
			sentinel.style.width = '100%';
			sentinel.style.pointerEvents = 'none';
			parte.parentNode.insertBefore(sentinel, parte);

			const io = new IntersectionObserver((entries) => {
				const entry = entries[0];
				// Determinar posición real del sentinel respecto al viewport
				const rect = sentinel.getBoundingClientRect();
				const rootTop = entry.rootBounds ? entry.rootBounds.top : 0; // 0 = borde superior del viewport
				const rootBottom = entry.rootBounds ? entry.rootBounds.bottom : window.innerHeight;

				// Reglas:
				// - Si el sentinel está visible (intersecting), quitar "stuck".
				// - Si NO está visible y su top < rootTop (ha pasado por arriba), poner "stuck".
				// - Si NO está visible y su top > rootBottom (está por debajo, aún no se ha llegado), quitar "stuck".
				if (entry.isIntersecting) {
					if (parte.classList.contains('stuck')) {
						parte.classList.remove('stuck');
						placeholder.style.display = 'none';
					}
				} else if (rect.top < rootTop) {
					if (!parte.classList.contains('stuck')) {
						parte.classList.add('stuck');
						console.log('add stuck');
						placeholder.style.display = 'block';
					}
				} else {
					if (parte.classList.contains('stuck')) {
						parte.classList.remove('stuck');
						placeholder.style.display = 'none';
					}
				}
			}, { root: null, threshold: 0 });

			io.observe(sentinel);

			// Asegurar estado inicial correcto en iOS cuando se carga arriba del todo
			if ((window.scrollY ?? window.pageYOffset ?? document.documentElement.scrollTop ?? 0) <= 0) {
				parte.classList.remove('stuck');
				placeholder.style.display = 'none';
			}
		})();
	</script>

	<div style="height: 100vh; display: flex; align-items: center; justify-content: center;"></div>

	<script is:inline defer>
		document.addEventListener('DOMContentLoaded', async () => {
			const animatedText = document.getElementById('animated-text');
			
			// Array de fuentes disponibles
			const fonts = [
				'Allerta Stencil',
				'Bungee Inline',
				'Chakra Petch',
				'Kranky',
				'Limelight',
				'Meow Script',
				'Modak',
				'Monoton',
				'Offside',
				'Pacifico',
				'Permanent Marker',
				'Rampart One',
				'Solway',
				'Tapestry',
				'Tiny5',
			];
			
			// Factor de escala para cada fuente para mantener tamaño visual consistente
			const fontSizeFactors = {
				'Allerta Stencil': 1.0,
				'Bungee Inline': 0.9,
				'Chakra Petch': 1,
				'Kranky': 1.0,
				'Limelight': 0.95,
				'Meow Script': 0.85,
				'Modak': 1.0,
				'Monoton': 0.8,
				'Offside': 1.1,
				'Pacifico': 0.8,
				'Permanent Marker': 1.0,
				'Rampart One': 0.8,
				'Solway': 1.15,
				'Tapestry': 1.05,
				'Tiny5': 1.2,
			};
			
			// Base font size in viewport width units
			const baseFontSize = 7; // corresponde al 7cqw en CSS
			const delayfont = 5000;
			
			// Variables de duración de transición
			const transitionDuration = {
				fadeOut: 600,    // Duración del fade-out en ms
				fadeIn: 800,     // Duración del fade-in en ms
				get total() { return this.fadeOut + this.fadeIn; } // Duración total
			};
			
			let currentFontIndex = 0;
			let fontsLoaded = false;

			// Función para precargar todas las fuentes
			async function preloadFonts() {
				console.log('Precargando fuentes...');
				
				try {
					// Usar Font Loading API si está disponible
					if ('fonts' in document) {
						const fontPromises = fonts.map(fontName => {
							// Usar peso Medium (500) para Solway y Chakra Petch
							// Usar peso Regular (400) para Modak, Monoton
							// Bold para el resto
							let fontWeight = 'bold';
							if (fontName === 'Solway' || fontName === 'Chakra Petch') {
								fontWeight = '500';
							} else if (fontName === 'Modak' || fontName === 'Monoton') {
								fontWeight = '400';
							}
							return document.fonts.load(`${fontWeight} 5rem "${fontName}"`);
						});
						
						await Promise.all(fontPromises);
						console.log('Todas las fuentes cargadas via Font Loading API');
					} else {
						// Fallback: crear elementos invisibles para forzar la carga
						const testContainer = document.createElement('div');
						testContainer.style.position = 'absolute';
						testContainer.style.visibility = 'hidden';
						testContainer.style.fontSize = '5rem';
						testContainer.style.fontWeight = 'bold';
						document.body.appendChild(testContainer);
						
						const loadPromises = fonts.map(fontName => {
							return new Promise((resolve) => {
								const testElement = document.createElement('span');
								testElement.textContent = 'PGSCOM';
								testElement.style.fontFamily = `"${fontName}", cursive`;
								// Aplicar peso específico para cada fuente
								if (fontName === 'Solway' || fontName === 'Chakra Petch') {
									testElement.style.fontWeight = '500';
								} else if (fontName === 'Modak' || fontName === 'Monoton') {
									testElement.style.fontWeight = '400';
								} else {
									testElement.style.fontWeight = 'bold';
								}
								testContainer.appendChild(testElement);
								
								// Esperar un poco para asegurar la carga
								setTimeout(() => {
									testContainer.removeChild(testElement);
									resolve();
								});
							});
						});
						
						await Promise.all(loadPromises);
						document.body.removeChild(testContainer);
						console.log('Todas las fuentes cargadas via fallback');
					}
					
					fontsLoaded = true;
				} catch (error) {
					console.log('Error cargando fuentes:', error);
					fontsLoaded = true; // Continuar de todos modos
				}
			}

			function changeFontFamily() {
				if (!fontsLoaded) return;
				
				// Usamos la referencia global
				const currentEl = window.animatedText;
				
				// Iniciar fade-out con blur
				currentEl.classList.add('fade-out');
				
				// Esperar a que se complete el fade-out antes de cambiar la fuente
				setTimeout(() => {
					// Cambiar a la siguiente fuente
					currentFontIndex = (currentFontIndex + 1) % fonts.length;
					const currentFont = fonts[currentFontIndex];
					
					// Cambiar la fuente mientras está invisible
					currentEl.style.fontFamily = `"${currentFont}", cursive`;
					
					// Aplicar peso específico para cada tipo de fuente
					if (currentFont === 'Solway' || currentFont === 'Chakra Petch') {
						currentEl.style.fontWeight = '500';
					} else if (currentFont === 'Modak' || currentFont === 'Monoton') {
						currentEl.style.fontWeight = '400';
					} else {
						currentEl.style.fontWeight = 'bold';
					}
					
					// Ajustar el tamaño según el factor de la fuente
					const factor = fontSizeFactors[currentFont] || 1.0;
					let newSize = baseFontSize * factor;
					// Duplicar tamaño en móvil
					if (window.matchMedia('(max-width: 768px)').matches) {
						newSize *= 2;
					}
					currentEl.style.fontSize = `${newSize}cqw`;
					
					console.log(`Font changed to: ${currentFont} (weight: ${currentEl.style.fontWeight}, factor: ${factor}, size: ${newSize}cqw)`);
					
					// Iniciar fade-in
					currentEl.classList.remove('fade-out');
					currentEl.classList.add('fade-in');
					
					// Remover la clase de fade-in después de completar la animación
					setTimeout(() => {
						currentEl.classList.remove('fade-in');
					}, transitionDuration.fadeIn);
					
				}, transitionDuration.fadeOut);
			}

			// Inicializar con la primera fuente y estado de carga
			const initialFont = fonts[0];
			animatedText.style.fontFamily = `"${initialFont}", cursive`;
			if (initialFont === 'Solway' || initialFont === 'Chakra Petch') {
				animatedText.style.fontWeight = '500';
			} else if (initialFont === 'Modak' || initialFont === 'Monoton') {
				animatedText.style.fontWeight = '400';
			} else {
				animatedText.style.fontWeight = 'bold';
			}
			
			// Aplicar el factor de escala inicial
			const initialFactor = fontSizeFactors[initialFont] || 1.0;
			// Ajustar tamaño según resolución: duplicar en móvil
			let initSize = baseFontSize * initialFactor;
			if (window.matchMedia('(max-width: 768px)').matches) {
				  initSize *= 2;
			}
			animatedText.style.fontSize = `${initSize}cqw`;
			
			animatedText.classList.add('loading');
			
			// Precargar todas las fuentes
			await preloadFonts();
			
			// Remover estado de carga y comenzar animación
			animatedText.classList.remove('loading');
			animatedText.classList.add('loaded');
			
			// Comenzar la animación solo después de cargar las fuentes
			console.log('Iniciando animación de fuentes...');
			
			// Referencia al elemento para que pueda ser actualizado en changeFontFamily
			window.animatedText = animatedText;
			
			setInterval(changeFontFamily, delayfont);
		});
	</script>
	<script type="module">
    import anime from 'https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.es.js';

    function initScrollAnim() {
        const targetEl = document.querySelector('.image-container');
        const logoEl = document.querySelector('#logoanimar');
	const galaxiaMaskEl = document.querySelector('.galaxiamask');
		const videoA = document.querySelector('#video-galaxia-a');
		const videoB = document.querySelector('#video-galaxia-b');
	const seqCanvas = document.querySelector('#galaxia-seq');

	if (!targetEl || !logoEl || !galaxiaMaskEl || !videoA || !videoB || !seqCanvas) return;

        // Detectar si es móvil
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        
	// Crear una timeline para mejor control de la animación
	const timeline = anime.timeline({
            autoplay: false,
            easing: 'easeOutQuart',
            duration: 1000 // Duración base más larga
        });

        // Agregar animaciones a la timeline (simultaneas)
		timeline
			// Ocultar el logo al inicio de la timeline
			/*.add({
				targets: logoEl,
				opacity: [0, 0],
				duration: 1
			}, 0)*/
            .add({
                targets: targetEl,
                /*translateX: isMobile ? 0 : 300,*/ // No mover horizontalmente en móvil
                /*translateY: isMobile ? 250 : 0,*/ // Mover verticalmente solo en móvil
                opacity: [1, 0], // Fade out simultáneo
                scale: [1, 0.8], // Reducir escala suavemente
                duration: isMobile ? 311 : 800, // Duración más larga para suavidad
                easing: 'easeOutQuart' // Easing más suave
            })
            .add({
                targets: logoEl,
				//opacity: [{ value: 1, duration: 1 }],
                scale: [1, 25], // Ampliar el logo de 1x a 25x
				translateY: [0, 45], // Desplazamiento hacia arriba
                duration: 1000,
                easing: 'easeInQuad',
                // Fusión: actualizar la máscara aquí para que esté sincronizada con el zoom del logo
                update: function(anim) {
                    // Declarar el tamaño en vh a partir del tamaño visual actual (incluye transform: scale)
                    const rect = logoEl.getBoundingClientRect();
                    const currentSize = (rect.height / window.innerHeight) * 100 - 5;

                    galaxiaMaskEl.style.webkitMaskSize = `auto ${currentSize}vh`;
                    galaxiaMaskEl.style.maskSize = `auto ${currentSize}vh`;
                }
				
            }, 1000) // Iniciar al mismo tiempo que la animación anterior
			// Animación del video para cambiar la reproducción

			// Ocultar el logo al finalizar su segmento
			.add({
				targets: logoEl,
				opacity: [{ value: 0, duration: 1 }]
			}, 1800);

		// --- Sincronización de video con la animación ---
		// Durante el zoom del logo (t=1000->2000ms de la timeline) scrubbear 0-2s de empezar.mp4
		// Al terminar el zoom, continuar reproduciendo empezar.mp4 hasta el final
		// Luego alternar loopinversed.mp4 y loop.mp4 en bucle

	const ZOOM_START_MS = 1000;
	const ZOOM_END_MS = 2000;
	const SCRUB_DURATION_S = 2; // primeros 2 segundos

		// Usar nombres reales del repo
	const VIDEO_INTRO = '/vid/empezar.mp4';
	const PLAYLIST = ['/vid/loopinversed.mp4', '/vid/loop.mp4'];
	let playlistIndex = 0;
	let isScrollScrubActive = true;
	let afterZoomPlaybackStarted = false;
	let activeMetadataReady = false;
	let playlistStarted = false;

	// Doble buffer de video
	let activeVideo = videoA;
	let bufferVideo = videoB;

	// Secuencia de frames AVIF en canvas para el tramo de zoom (120fps, 2s)
	const SEQ_FPS = 120;
	const SEQ_DURATION_S = 2;
	let TOTAL_FRAMES = Math.floor(SEQ_FPS * SEQ_DURATION_S); // normalmente 240, pero detectaremos si hay 241 (0..240)
	const FRAME_BASE = '/vid/empezar/';
	let FRAME_EXT = 'avif';
	let frameStartIndex = 0; // detectaremos 0 o 1 según exportación
	let padWidth = 0; // si los ficheros usan ceros a la izquierda (ej: 000.avif)
	const imagesCache = [];
	const ctx = seqCanvas.getContext('2d');
	let lastDrawnIndex = -1;
	let sequenceActive = false;

	function padNum(i) {
		if (!padWidth || padWidth <= 1) return String(i);
		return String(i).padStart(padWidth, '0');
	}

	function frameSrc(i) { return `${FRAME_BASE}${padNum(i)}.${FRAME_EXT}`; }

	function resizeCanvas() {
		const rect = galaxiaMaskEl.getBoundingClientRect();
		const ratio = window.devicePixelRatio || 1;
		seqCanvas.width = Math.max(1, Math.floor(rect.width * ratio));
		seqCanvas.height = Math.max(1, Math.floor(rect.height * ratio));
		seqCanvas.style.width = '100%';
		seqCanvas.style.height = '100%';
	}

	function drawImageCover(img) {
		if (!img || !ctx) return;
		const cw = seqCanvas.width;
		const ch = seqCanvas.height;
		const iw = img.naturalWidth;
		const ih = img.naturalHeight;
		if (!iw || !ih || !cw || !ch) return;
		const scale = Math.max(cw / iw, ch / ih);
		const nw = iw * scale;
		const nh = ih * scale;
		const dx = (cw - nw) / 2;
		const dy = (ch - nh) / 2;
		ctx.clearRect(0, 0, cw, ch);
		ctx.drawImage(img, dx, dy, nw, nh);
	}

	function loadFrame(i) {
		if (imagesCache[i]) return imagesCache[i];
		const img = new Image();
		img.decoding = 'async';
		img.src = frameSrc(i);
		imagesCache[i] = new Promise((resolve) => {
			const done = () => resolve(img);
			img.onload = done; img.onerror = done;
			if (img.decode) { img.decode().then(done).catch(done); }
		});
		return imagesCache[i];
	}

	async function detectFrameRange() {
		// Probar si la secuencia comienza en 0 o en 1
		function test(src) {
			return new Promise((resolve) => {
				const img = new Image();
				img.onload = () => resolve(true);
				img.onerror = () => resolve(false);
				img.src = src;
			});
		}
		// Detectar extensión disponible: preferir avif → webp → png
		const exts = ['avif', 'webp', 'png'];
		for (const ext of exts) {
			// Para cada extensión, averiguar si hay archivos con padding (3,2,1) o sin padding
			let found = false;
			for (const w of [3,2,1,0]) {
				const candidate = FRAME_BASE + (w > 0 ? String(0).padStart(w,'0') : '0') + `.${ext}`;
				if (await test(candidate)) { FRAME_EXT = ext; padWidth = w; found = true; break; }
				// también probar el siguiente índice (1) por si empieza en 1
				const candidate1 = FRAME_BASE + (w > 0 ? String(1).padStart(w,'0') : '1') + `.${ext}`;
				if (await test(candidate1)) { FRAME_EXT = ext; padWidth = w; found = true; break; }
			}
			if (found) break;
		}
		// Ahora probar existencia real usando la función frameSrc (que ya usa padWidth)
		const hasZero = await test(frameSrc(0));
		if (hasZero) { frameStartIndex = 0; }
		else {
			const hasOne = await test(frameSrc(1));
			if (hasOne) { frameStartIndex = 1; }
			else { frameStartIndex = 0; }
		}
		// Detectar si hay 241 frames (0..240) o 240 (0..239)
		const probe240 = frameStartIndex + 240;
		if (await test(frameSrc(probe240))) {
			TOTAL_FRAMES = probe240 - frameStartIndex + 1; // 241
		} else {
			const probe239 = frameStartIndex + 239;
			if (await test(frameSrc(probe239))) {
				TOTAL_FRAMES = probe239 - frameStartIndex + 1; // 240
			} else {
				// Fallback seguro
				TOTAL_FRAMES = Math.max(1, TOTAL_FRAMES);
			}
		}
	}

	function primePreload() {
		// Precargar primeros ~100 frames para fluidez inicial
		const FIRST = frameStartIndex;
		const LAST = Math.min(frameStartIndex + TOTAL_FRAMES - 1, frameStartIndex + 99);
		for (let i = FIRST; i <= LAST; i++) loadFrame(i);
		// Preload del resto en segundo plano
		setTimeout(() => {
			const end = frameStartIndex + TOTAL_FRAMES - 1;
			for (let i = LAST + 1; i <= end; i++) loadFrame(i);
		}, 500);
	}

	function setSequenceVisible(v) {
		if (v) {
			if (!sequenceActive) {
				sequenceActive = true;
				seqCanvas.style.opacity = '1';
				activeVideo.style.opacity = '0';
				bufferVideo.style.opacity = '0';
			}
		} else {
			if (sequenceActive) {
				sequenceActive = false;
				seqCanvas.style.opacity = '0';
			}
		}
	}

	async function showFrame(index) {
		if (index === lastDrawnIndex) return;
		lastDrawnIndex = index;
		const img = await loadFrame(index);
		if (lastDrawnIndex !== index) return; // Evitar draw desfasado
		drawImageCover(img);
	}

	// Inicializar canvas y precarga
	resizeCanvas();
	window.addEventListener('resize', resizeCanvas);
	// Detectar rango de la secuencia (inicio y total), precargar y pintar primer frame
	detectFrameRange().then(() => {
		primePreload();
		setSequenceVisible(true);
		showFrame(frameStartIndex);
	});

	// Scheduler de scrubbing para fluidez - optimizado
	let pendingScrubT = null;
	let scrubRafId = 0;
	let lastScrubbedT = -1;
	const SCRUB_EPS = 0.04; // segundos; evita micro-seeks <40ms (aumentado para mejor rendimiento)

	function applyScrub() {
		scrubRafId = 0;
		if (pendingScrubT == null || !activeMetadataReady) return;
		const t = pendingScrubT;
		pendingScrubT = null;
		// Evitar mover si ya estamos muy cerca
		try {
			const cur = activeVideo.currentTime || 0;
			if (Math.abs(cur - t) < SCRUB_EPS) return;
			if (typeof activeVideo.fastSeek === 'function') {
				activeVideo.fastSeek(t);
			} else {
				activeVideo.currentTime = t;
			}
			lastScrubbedT = t;
		} catch {}
	}

	function scheduleScrub(t) {
		pendingScrubT = t;
		if (!scrubRafId) scrubRafId = requestAnimationFrame(applyScrub);
	}

		function waitForMetadata(el) {
			return new Promise((resolve) => {
				if (el.readyState >= 1 && !isNaN(el.duration)) {
					resolve();
					return;
				}
				const onLoaded = () => {
					el.removeEventListener('loadedmetadata', onLoaded);
					resolve();
				};
				el.addEventListener('loadedmetadata', onLoaded, { once: true });
			});
		}

		async function setVideoSource(el, src, startTime = 0, autoplay = false) {
			try {
				el.loop = false;
				// Cambiar src directamente en el video
				if (el.src !== location.origin + src && el.src !== src) {
					el.src = src;
				}
				// Forzar carga de metadatos
				el.load();
				await waitForMetadata(el);
				if (el === activeVideo) activeMetadataReady = true;
				// Posicionar
				const clampedStart = Math.max(0, Math.min(startTime, (el.duration || Infinity)));
				if (!Number.isNaN(clampedStart)) {
					try { el.currentTime = clampedStart; } catch {}
				}
				if (autoplay) {
					try { await el.play(); } catch {}
				} else {
					el.pause();
				}
			} catch (e) {
				// Silencioso: si falla, no romper la animación
			}
		}

		async function prepareNext(src) {
			// Precargar en el buffer
			await setVideoSource(bufferVideo, src, 0, false);
			// Opcional: priming del decodificador
			try { await bufferVideo.play(); bufferVideo.pause(); } catch {}
		}

		function attachEndedHandler() {
			activeVideo.onended = async () => {
				// Primera vez: venimos del intro
				if (!playlistStarted) {
					playlistStarted = true;
				}
				// Swap al buffer ya precargado
				await swapToPreloaded();
				// Preparar el siguiente en la lista
				playlistIndex = (playlistIndex + 1) % PLAYLIST.length;
				prepareNext(PLAYLIST[playlistIndex]);
			};
			bufferVideo.onended = null;
		}

		async function swapToPreloaded() {
			// Asegurar visible y reproduciendo el buffer antes del swap
			try { bufferVideo.currentTime = 0; } catch {}
			try { await bufferVideo.play(); } catch {}
			bufferVideo.style.opacity = '1';
			// Esperar 2 frames para asegurar un render antes de ocultar el activo
			await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));
			// Ocultar/pausar el activo
			activeVideo.style.opacity = '0';
			try { activeVideo.pause(); } catch {}
			// Intercambiar referencias
			const tmp = activeVideo; activeVideo = bufferVideo; bufferVideo = tmp;
			attachEndedHandler();
		}

		// Preparar el video inicial para scrubbing en el activo y precargar el primero del playlist en el buffer
		setVideoSource(activeVideo, VIDEO_INTRO, 0, false);
		prepareNext(PLAYLIST[playlistIndex]); // playlistIndex === 0 al inicio
		attachEndedHandler();

        function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

		// Optimized scroll handler with requestAnimationFrame throttling
		let lastSeekTime = -1;
		let scrollRafId = 0;
		let lastScrollTime = 0;
		const SEEK_THRESHOLD_MS = 5; // Only seek if difference is > 5ms

		function onScrollThrottled() {
			const now = performance.now();
			const scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
			// Obtener el scrollHeight real del elemento de scroll
			const scrollEl = document.scrollingElement || document.documentElement || document.body;
			const scrollHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight, scrollEl.scrollHeight);
			const viewportHeight = window.innerHeight; // o document.documentElement.clientHeight
			const maxScroll = Math.max(0, scrollHeight - viewportHeight);

			// Evitar división por cero
			const progress = maxScroll > 0 ? clamp(scrollY / maxScroll, 0, 1) : 0;
			const seekTime = progress * timeline.duration;

			// Optimización: solo actualizar timeline si hay cambio significativo
			if (Math.abs(seekTime - lastSeekTime) > SEEK_THRESHOLD_MS) {
				timeline.seek(seekTime);
				lastSeekTime = seekTime;
			}

			// Sincronización del video con el tramo de zoom
			if (isScrollScrubActive) {
				if (seekTime <= ZOOM_START_MS) {
					// Antes del zoom: pausar en 0 y mostrar primer frame
					try { if (!activeVideo.paused) activeVideo.pause(); } catch {}
					setSequenceVisible(true);
					showFrame(frameStartIndex);
				} else if (seekTime < ZOOM_END_MS) {
					// En el zoom: scrubbing 0-2s sobre la secuencia AVIF
					const localP = (seekTime - ZOOM_START_MS) / (ZOOM_END_MS - ZOOM_START_MS);
					const start = frameStartIndex;
					const end = frameStartIndex + TOTAL_FRAMES - 1;
					const frameIndex = Math.max(start, Math.min(end, Math.round(start + localP * (TOTAL_FRAMES - 1))));
					try { if (!activeVideo.paused) activeVideo.pause(); } catch {}
					setSequenceVisible(true);
					showFrame(frameIndex);
				} else {
					// Después del zoom: continuar reproduciendo el intro
					if (!afterZoomPlaybackStarted && activeMetadataReady) {
						afterZoomPlaybackStarted = true;
						isScrollScrubActive = false; // Dejar de scrubbear tras iniciar reproducción continua
						// La 2ª parte del video ya viene recortada: empezar desde 0
						try { activeVideo.currentTime = 0; } catch {}
						try { activeVideo.play(); } catch {}
						activeVideo.style.opacity = '1';
						setSequenceVisible(false);
						// Limpiar scheduler de scrubbing
						pendingScrubT = null;
						if (scrubRafId) { cancelAnimationFrame(scrubRafId); scrubRafId = 0; }
						lastScrubbedT = -1;
					}
				}
			}

			lastScrollTime = now;
			scrollRafId = 0;
		}

		function onScroll() {
			// Throttle scroll events with requestAnimationFrame for better performance
			if (!scrollRafId) {
				scrollRafId = requestAnimationFrame(onScrollThrottled);
			}
		}

        onScrollThrottled(); // Initial call
        window.addEventListener('scroll', onScroll, { passive: true });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollAnim);
    } else {
        initScrollAnim();
    }
</script>
</Layout>