	<!-- #region 📬 SCRIPT: FORMULARIO DE CONTACTO - Validación y animaciones -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const form = document.getElementById('contactForm');
			const formStatus = document.getElementById('formStatus');

			if (!form || !formStatus) return;

			// Animación de entrada de los campos del formulario
			const formGroups = form.querySelectorAll('.form-group');
			formGroups.forEach((group, index) => {
				group.style.opacity = '0';
				group.style.transform = 'translateY(20px)';
				setTimeout(() => {
					group.style.transition = 'all 0.6s ease';
					group.style.opacity = '1';
					group.style.transform = 'translateY(0)';
				}, index * 100);
			});

			// Función para mostrar mensajes de estado
			function showStatus(message, type) {
				formStatus.textContent = message;
				formStatus.className = `form-status show ${type}`;
				
				// Ocultar después de 5 segundos
				setTimeout(() => {
					formStatus.classList.remove('show');
				}, 5000);
			}

			// Validación en tiempo real
			const inputs = form.querySelectorAll('input, textarea');
			inputs.forEach(input => {
				input.addEventListener('blur', function() {
					if (this.value.trim() === '' && this.hasAttribute('required')) {
						this.style.borderColor = 'rgba(239, 68, 68, 0.6)';
					} else if (this.type === 'email' && this.value.trim() !== '') {
						const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
						if (!emailRegex.test(this.value)) {
							this.style.borderColor = 'rgba(239, 68, 68, 0.6)';
						} else {
							this.style.borderColor = 'rgba(34, 197, 94, 0.6)';
						}
					} else if (this.value.trim() !== '') {
						this.style.borderColor = 'rgba(34, 197, 94, 0.6)';
					}
				});

				input.addEventListener('focus', function() {
					this.style.borderColor = 'rgba(0, 180, 216, 0.6)';
				});
			});

			// Manejo del envío del formulario
			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				// Obtener datos del formulario
				const formData = new FormData(form);
				const data = Object.fromEntries(formData);

				// Validación básica
				if (!data.nombre || !data.email || !data.asunto || !data.mensaje) {
					showStatus('⚠️ Por favor, completa todos los campos', 'error');
					return;
				}

				// Validación de email
				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!emailRegex.test(data.email)) {
					showStatus('⚠️ Por favor, ingresa un email válido', 'error');
					return;
				}

				// Validación de Turnstile (Cliente)
				const turnstileResponse = data['cf-turnstile-response'];
				if (!turnstileResponse) {
					showStatus('⚠️ Verificación de seguridad fallida. Por favor, recarga la página.', 'error');
					return;
				}

				// Deshabilitar botón mientras se envía
				const submitBtn = form.querySelector('.submit-btn');
				const originalText = submitBtn.querySelector('.btn-text').textContent;
				submitBtn.disabled = true;
				submitBtn.querySelector('.btn-text').textContent = 'Enviando...';
				submitBtn.style.opacity = '0.7';

				try {
					// Enviar al backend de Cloudflare Pages Functions
					const resp = await fetch('/contact', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({
							nombre: data.nombre,
							email: data.email,
							asunto: data.asunto,
							mensaje: data.mensaje,
							'cf-turnstile-response': data['cf-turnstile-response']
						}),
					});

					const json = await resp.json().catch(() => ({ ok: false }));
					if (!resp.ok || !json.ok) {
						throw new Error(json.error || 'Error en el servidor');
					}

					showStatus('✨ ¡Mensaje enviado con éxito! Te responderé pronto.', 'success');
					form.reset();

					// Resetear bordes de inputs
					inputs.forEach(input => {
						input.style.borderColor = 'rgba(0, 180, 216, 0.2)';
					});

				} catch (error) {
					console.error('Error al enviar el formulario:', error);
					showStatus('❌ Error al enviar el mensaje. Inténtalo nuevamente.', 'error');
				} finally {
					// Rehabilitar botón
					submitBtn.disabled = false;
					submitBtn.querySelector('.btn-text').textContent = originalText;
					submitBtn.style.opacity = '1';
				}
			});

			// Efecto de partículas al interactuar con el formulario
			let interactionCount = 0;
			form.addEventListener('input', () => {
				interactionCount++;
				if (interactionCount % 5 === 0) {
					createSparkle(form);
				}
			});

			function createSparkle(element) {
				const sparkle = document.createElement('div');
				sparkle.style.position = 'absolute';
				sparkle.style.width = '4px';
				sparkle.style.height = '4px';
				sparkle.style.background = '#48cae4';
				sparkle.style.borderRadius = '50%';
				sparkle.style.pointerEvents = 'none';
				sparkle.style.boxShadow = '0 0 10px #48cae4';
				
				const rect = element.getBoundingClientRect();
				sparkle.style.left = `${Math.random() * rect.width}px`;
				sparkle.style.top = `${Math.random() * rect.height}px`;
				
				element.appendChild(sparkle);

				// Animar y eliminar
				setTimeout(() => {
					sparkle.style.transition = 'all 1s ease-out';
					sparkle.style.transform = `translateY(-${Math.random() * 50 + 20}px)`;
					sparkle.style.opacity = '0';
				}, 10);

				setTimeout(() => sparkle.remove(), 1100);
			}
		});
	</script>
