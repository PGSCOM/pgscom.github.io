	<!-- #region 🎬 SCRIPT: ANIMACIONES PROYECTOS -->
	<script type="module">
		import gsap from 'https://cdn.jsdelivr.net/npm/gsap@3.12.7/+esm';
		import ScrollTrigger from 'https://cdn.jsdelivr.net/npm/gsap@3.12.7/ScrollTrigger/+esm';
		
		// Registrar plugins de GSAP
		gsap.registerPlugin(ScrollTrigger);

		document.addEventListener('DOMContentLoaded', () => {
			const section = document.querySelector('.proyectos-section');
			const container = document.querySelector('.proyectos-container');
			const grid = document.querySelector('.proyectos-grid');
			const logo = document.querySelector('.proyectos-logo');
			const detailScreens = document.querySelectorAll('.aptitud-detail-screen');
			
			if (!section || !container || !grid || !logo || detailScreens.length === 0) return;

			const totalAptitudes = detailScreens.length;
			let currentAptitudIndex = -1; // -1 = vista órbita, 0+ = pantalla de aptitud

			// Detectar si es móvil para adaptar comportamiento
			const isMobileView = window.matchMedia('(max-width: 768px)').matches;

			// Función para actualizar las líneas de una pantalla (usada en resize y show)
			function updateAptitudLines(screen) {
				if (!screen || isMobileView) return;

				const aptitudCircle = screen.querySelector('.aptitud-circle');
				const linesContainer = screen.querySelector('.lines-to-projects');
				const linesToProjects = screen.querySelectorAll('.line-aptitud-proyecto');
				const projectCards = screen.querySelectorAll('.proyecto-detail-card');
				
				if (!aptitudCircle || !linesContainer) return;

				const circleRadius = aptitudCircle.offsetWidth / 2;
				const screenRect = screen.getBoundingClientRect();
				const circleCenterX = screenRect.left + screenRect.width / 2;
				const circleCenterY = screenRect.top + screenRect.height / 2;
				
				linesContainer.style.left = `${screenRect.width / 2}px`;
				linesContainer.style.top = `${screenRect.height / 2}px`;
				
				linesToProjects.forEach((line, i) => {
					const card = projectCards[i];
					if (!card) return;
					
					const cardRect = card.getBoundingClientRect();
					const style = window.getComputedStyle(card);
					const matrix = new DOMMatrix(style.transform);
					
					const cardLeft = cardRect.left - matrix.m41;
					const cardTop = cardRect.top - matrix.m42;
					const cardHeight = cardRect.height;
					
					const targetX = cardLeft;
					const targetY = cardTop + cardHeight / 2;
					
					const dx = targetX - circleCenterX;
					const dy = targetY - circleCenterY;
					
					const angle = Math.atan2(dy, dx) * (180 / Math.PI);
					const totalDistance = Math.sqrt(dx * dx + dy * dy);
					const lineLength = totalDistance - circleRadius;
					
					line.style.transform = `rotate(${angle}deg) translateX(${circleRadius}px)`;
					
					if (line.style.width && line.style.width !== '0px') {
						line.style.width = `${Math.max(0, lineLength)}px`;
					}
					
					line.dataset.targetWidth = Math.max(0, lineLength);
				});
			}

			// Animación de entrada para una pantalla de aptitud con GSAP
			function showAptitudScreen(index) {
				const screen = detailScreens[index];
				if (!screen) return;

				screen.classList.add('active');

				const lineLogoAptitud = screen.querySelector('.line-logo-aptitud');
				const aptitudCircle = screen.querySelector('.aptitud-circle');
				const linesToProjects = screen.querySelectorAll('.line-aptitud-proyecto');
				const projectCards = screen.querySelectorAll('.proyecto-detail-card');

				updateAptitudLines(screen);

				// Timeline de entrada con GSAP
				const enterTl = gsap.timeline({ defaults: { ease: 'power2.out' } });

				// 1. Fade in screen
				enterTl.fromTo(screen, 
					{ opacity: 0 },
					{ opacity: 1, duration: 0.3 }
				);

				// 2. Línea desde logo hacia aptitud (solo en desktop)
				if (!isMobileView && lineLogoAptitud) {
					const logoLineStart = lineLogoAptitud.getBoundingClientRect().left;
					const screenRect = screen.getBoundingClientRect();
					const circleCenterX = screenRect.left + screenRect.width / 2;
					const circleRadius = aptitudCircle.offsetWidth / 2;
					const circleLeftEdge = circleCenterX - circleRadius;
					const logoLineWidth = Math.max(0, circleLeftEdge - logoLineStart);

					enterTl.fromTo(lineLogoAptitud, 
						{ width: '0px', opacity: 0 },
						{ width: `${logoLineWidth}px`, opacity: 1, duration: 0.4 },
						0.1
					);
				}

				// 3. Círculo de aptitud aparece
				enterTl.fromTo(aptitudCircle,
					{ opacity: 0, scale: 0.5 },
					{ opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(1.7)' },
					isMobileView ? 0.1 : 0.4
				);

				// 4. Líneas hacia tarjetas (solo en desktop)
				const linesDelay = isMobileView ? 0.3 : 0.65;
				
				if (!isMobileView) {
					linesToProjects.forEach((line, i) => {
						const targetWidth = line.dataset.targetWidth || 100;
						enterTl.fromTo(line,
							{ width: '0px', opacity: 0 },
							{ width: `${targetWidth}px`, opacity: 1, duration: 0.35, ease: 'power2.out' },
							linesDelay + (i * 0.08)
						);
					});
				}

				// 5. Tarjetas de proyecto con stagger
				const cardsStartDelay = isMobileView ? 0.4 : (0.65 + (linesToProjects.length * 0.08) + 0.1);
				enterTl.fromTo(projectCards,
					{ 
						opacity: 0, 
						x: isMobileView ? 0 : 30,
						y: isMobileView ? 20 : 0
					},
					{ 
						opacity: 1, 
						x: 0, 
						y: 0, 
						duration: 0.4,
						stagger: 0.08,
						ease: 'power2.out'
					},
					cardsStartDelay
				);

				return enterTl;
			}

			// Animación de salida para una pantalla de aptitud con GSAP
			function hideAptitudScreen(index) {
				const screen = detailScreens[index];
				if (!screen) return Promise.resolve();

				return new Promise((resolve) => {
					const exitTl = gsap.timeline({
						defaults: { ease: 'power2.in' },
						onComplete: () => {
							screen.classList.remove('active');
							resolve();
						}
					});

					const projectCards = screen.querySelectorAll('.proyecto-detail-card');
					const linesToProjects = screen.querySelectorAll('.line-aptitud-proyecto');
					const aptitudCircle = screen.querySelector('.aptitud-circle');
					const lineLogoAptitud = screen.querySelector('.line-logo-aptitud');

					// Salida en orden inverso con stagger reverso
					exitTl.to(projectCards, {
						opacity: 0,
						x: isMobileView ? 0 : -30,
						y: isMobileView ? -20 : 0,
						duration: 0.3,
						stagger: { each: 0.04, from: 'end' }
					});

					// Animar líneas (solo en desktop)
					if (!isMobileView) {
						linesToProjects.forEach((line, i) => {
							const currentWidth = line.style.width || '0px';
							exitTl.fromTo(line,
								{ width: currentWidth, opacity: 1 },
								{ width: '0px', opacity: 0, duration: 0.25 },
								0.2 + (i * 0.03)
							);
						});
					}

					exitTl.to(aptitudCircle, {
						opacity: 0,
						scale: 0.5,
						duration: 0.3
					}, isMobileView ? 0.2 : 0.35);

					// Línea logo-aptitud solo en desktop
					if (!isMobileView && lineLogoAptitud) {
						const logoLineStart = lineLogoAptitud.getBoundingClientRect().left;
						const circleLeft = aptitudCircle.getBoundingClientRect().left;
						const logoLineWidth = Math.max(0, circleLeft - logoLineStart);

						exitTl.fromTo(lineLogoAptitud,
							{ width: `${logoLineWidth}px`, opacity: 1 },
							{ width: '0px', opacity: 0, duration: 0.3 },
							0.45
						);
					}

					exitTl.to(screen, {
						opacity: 0,
						duration: 0.2
					}, 0.6);
				});
			}

			// Timeline principal para la transición órbita -> primera aptitud con GSAP
			const mainTimeline = gsap.timeline({ paused: true });

			// Calcular desplazamiento del logo según pantalla
			const isMobile = window.matchMedia('(max-width: 768px)').matches;
			const logoTranslation = isMobile ? 0 : -280;

			// Ocultar órbita PRIMERO (el logo NO se mueve aún) - 0s a 0.5s
			mainTimeline.to(grid, {
				opacity: 0,
				scale: 0.5,
				duration: 0.5,
				ease: 'power2.out'
			}, 0)
			// Mover logo hacia la izquierda DESPUÉS de que la órbita desaparezca - 0.5s a 1s
			.to(logo, {
				x: logoTranslation,
				scale: 0.85,
				opacity: isMobile ? 0 : 1,
				duration: 0.5,
				ease: 'power2.out'
			}, 0.5);

			// Control de scroll con múltiples fases
			const ORBIT_PHASE_RATIO = 0.10;
			const aptitudPhaseRatio = (1 - ORBIT_PHASE_RATIO) / totalAptitudes;

			function onScroll() {
				const rect = section.getBoundingClientRect();
				const viewportHeight = window.innerHeight;
				const totalScrollHeight = section.offsetHeight - viewportHeight;
				
				let progress = 0;
				if (rect.top <= 0) {
					const scrolled = Math.abs(rect.top);
					progress = Math.min(1, Math.max(0, scrolled / totalScrollHeight));
				}

				// Fase de transición órbita
				if (progress <= ORBIT_PHASE_RATIO) {
					const orbitProgress = progress / ORBIT_PHASE_RATIO;
					mainTimeline.progress(orbitProgress);
					
					if (currentAptitudIndex >= 0) {
						hideAptitudScreen(currentAptitudIndex);
						currentAptitudIndex = -1;
					}
				} else {
					mainTimeline.progress(1);
					
					const aptitudProgress = (progress - ORBIT_PHASE_RATIO) / (1 - ORBIT_PHASE_RATIO);
					const newAptitudIndex = Math.min(
						totalAptitudes - 1,
						Math.floor(aptitudProgress * totalAptitudes)
					);

					if (newAptitudIndex !== currentAptitudIndex) {
						if (currentAptitudIndex >= 0) {
							hideAptitudScreen(currentAptitudIndex);
						}
						currentAptitudIndex = newAptitudIndex;
						showAptitudScreen(currentAptitudIndex);
					}
				}
			}

			window.addEventListener('scroll', onScroll, { passive: true });
			
			window.addEventListener('resize', () => {
				if (currentAptitudIndex >= 0 && !isMobileView) {
					const screen = detailScreens[currentAptitudIndex];
					updateAptitudLines(screen);
				}
			});
			
			onScroll();
		});
	</script>
	<!-- #endregion -->

	<!-- #region 📬 SCRIPT: FORMULARIO DE CONTACTO - Validación y animaciones -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const form = document.getElementById('contactForm');
			const formStatus = document.getElementById('formStatus');

			if (!form || !formStatus) return;

			// Animación de entrada de los campos del formulario
			const formGroups = form.querySelectorAll('.form-group');
			formGroups.forEach((group, index) => {
				group.style.opacity = '0';
				group.style.transform = 'translateY(20px)';
				setTimeout(() => {
					group.style.transition = 'all 0.6s ease';
					group.style.opacity = '1';
					group.style.transform = 'translateY(0)';
				}, index * 100);
			});

			// Función para mostrar mensajes de estado
			function showStatus(message, type) {
				formStatus.textContent = message;
				formStatus.className = `form-status show ${type}`;
				
				// Ocultar después de 5 segundos
				setTimeout(() => {
					formStatus.classList.remove('show');
				}, 5000);
			}

			// Validación en tiempo real
			const inputs = form.querySelectorAll('input, textarea');
			inputs.forEach(input => {
				input.addEventListener('blur', function() {
					if (this.value.trim() === '' && this.hasAttribute('required')) {
						this.style.borderColor = 'rgba(239, 68, 68, 0.6)';
					} else if (this.type === 'email' && this.value.trim() !== '') {
						const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
						if (!emailRegex.test(this.value)) {
							this.style.borderColor = 'rgba(239, 68, 68, 0.6)';
						} else {
							this.style.borderColor = 'rgba(34, 197, 94, 0.6)';
						}
					} else if (this.value.trim() !== '') {
						this.style.borderColor = 'rgba(34, 197, 94, 0.6)';
					}
				});

				input.addEventListener('focus', function() {
					this.style.borderColor = 'rgba(0, 180, 216, 0.6)';
				});
			});

			// Manejo del envío del formulario
			form.addEventListener('submit', async (e) => {
				e.preventDefault();

				// Obtener datos del formulario
				const formData = new FormData(form);
				const data = Object.fromEntries(formData);

				// Validación básica
				if (!data.nombre || !data.email || !data.asunto || !data.mensaje) {
					showStatus('⚠️ Por favor, completa todos los campos', 'error');
					return;
				}

				// Validación de email
				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!emailRegex.test(data.email)) {
					showStatus('⚠️ Por favor, ingresa un email válido', 'error');
					return;
				}

				// Validación de Turnstile (Cliente)
				const turnstileResponse = data['cf-turnstile-response'];
				if (!turnstileResponse) {
					showStatus('⚠️ Verificación de seguridad fallida. Por favor, recarga la página.', 'error');
					return;
				}

				// Deshabilitar botón mientras se envía
				const submitBtn = form.querySelector('.submit-btn');
				const originalText = submitBtn.querySelector('.btn-text').textContent;
				submitBtn.disabled = true;
				submitBtn.querySelector('.btn-text').textContent = 'Enviando...';
				submitBtn.style.opacity = '0.7';

				try {
					// Enviar al backend de Cloudflare Pages Functions
					const resp = await fetch('/contact', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({
							nombre: data.nombre,
							email: data.email,
							asunto: data.asunto,
							mensaje: data.mensaje,
							'cf-turnstile-response': data['cf-turnstile-response']
						}),
					});

					const json = await resp.json().catch(() => ({ ok: false }));
					if (!resp.ok || !json.ok) {
						throw new Error(json.error || 'Error en el servidor');
					}

					showStatus('✨ ¡Mensaje enviado con éxito! Te responderé pronto.', 'success');
					form.reset();

					// Resetear bordes de inputs
					inputs.forEach(input => {
						input.style.borderColor = 'rgba(0, 180, 216, 0.2)';
					});

				} catch (error) {
					console.error('Error al enviar el formulario:', error);
					showStatus('❌ Error al enviar el mensaje. Inténtalo nuevamente.', 'error');
				} finally {
					// Rehabilitar botón
					submitBtn.disabled = false;
					submitBtn.querySelector('.btn-text').textContent = originalText;
					submitBtn.style.opacity = '1';
				}
			});

			// Efecto de partículas al interactuar con el formulario
			let interactionCount = 0;
			form.addEventListener('input', () => {
				interactionCount++;
				if (interactionCount % 5 === 0) {
					createSparkle(form);
				}
			});

			function createSparkle(element) {
				const sparkle = document.createElement('div');
				sparkle.style.position = 'absolute';
				sparkle.style.width = '4px';
				sparkle.style.height = '4px';
				sparkle.style.background = '#48cae4';
				sparkle.style.borderRadius = '50%';
				sparkle.style.pointerEvents = 'none';
				sparkle.style.boxShadow = '0 0 10px #48cae4';
				
				const rect = element.getBoundingClientRect();
				sparkle.style.left = `${Math.random() * rect.width}px`;
				sparkle.style.top = `${Math.random() * rect.height}px`;
				
				element.appendChild(sparkle);

				// Animar y eliminar
				setTimeout(() => {
					sparkle.style.transition = 'all 1s ease-out';
					sparkle.style.transform = `translateY(-${Math.random() * 50 + 20}px)`;
					sparkle.style.opacity = '0';
				}, 10);

				setTimeout(() => sparkle.remove(), 1100);
			}
		});
	</script>
