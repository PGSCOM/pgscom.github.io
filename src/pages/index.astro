	<!-- #region 🪟 SCRIPT MODAL DE PROYECTOS -->
	<script define:vars={{ proyectosData }}>
		document.addEventListener('DOMContentLoaded', () => {
			const modal = document.getElementById('proyectoModal');
			const modalClose = document.getElementById('modalClose');
			const modalTitulo = document.getElementById('modalTitulo');
			const modalBackdrop = document.getElementById('modalBackdrop');
			const modalPoster = document.getElementById('modalPoster');
			const modalMeta = document.getElementById('modalMeta');
			const modalTagline = document.getElementById('modalTagline');
			const modalDescripcion = document.getElementById('modalDescripcion');
			const modalTecnologias = document.getElementById('modalTecnologias');
			const modalContenido = document.getElementById('modalContenido');
			const modalLink = document.getElementById('modalLink');
			const modalShare = document.getElementById('modalShare');

			// Función para encontrar proyecto por ID y su aptitud
			function findProyectoWithAptitud(proyectoId) {
				for (const aptitud of proyectosData) {
					const proyecto = aptitud.proyectos.find(p => p.id === proyectoId);
					if (proyecto) return { proyecto, aptitud };
				}
				return null;
			}

			// Abrir modal
			function openModal(proyectoId) {
				const result = findProyectoWithAptitud(proyectoId);
				if (!result) return;
				
				const { proyecto, aptitud } = result;

				// Título
				modalTitulo.textContent = proyecto.titulo;
				
				// Imagen de fondo (usa imagenFondo si existe, sino la imagen normal)
				modalBackdrop.src = proyecto.imagenFondo || proyecto.imagen;
				modalBackdrop.alt = proyecto.titulo;
				
				// Poster cuadrado (usa la imagen normal)
				modalPoster.src = proyecto.imagen;
				modalPoster.alt = proyecto.titulo;
				
				// Meta información (categoría, premio si existe)
				let metaHTML = `<span class="modal-meta-item">${aptitud.titulo}</span>`;
				if (proyecto.premio) {
					metaHTML += `<span class="modal-meta-badge">🏆 ${proyecto.premio}</span>`;
				}
				if (proyecto.tecnologias && proyecto.tecnologias.length > 0) {
					metaHTML += `<span class="modal-meta-item">${proyecto.tecnologias.length} tecnologías</span>`;
				}
				modalMeta.innerHTML = metaHTML;
				
				// Tagline / descripción corta
				modalTagline.textContent = proyecto.descripcion || '';
				
				// Descripción completa (si no hay contenido HTML)
				if (proyecto.descripcion) {
					modalDescripcion.textContent = proyecto.descripcion;
					modalDescripcion.parentElement.style.display = 'block';
				} else {
					modalDescripcion.parentElement.style.display = 'none';
				}
				
				// Tecnologías
				modalTecnologias.innerHTML = proyecto.tecnologias 
					? proyecto.tecnologias.map(t => `<span class="modal-tech-tag">${t}</span>`).join('')
					: '';
				
				// Contenido HTML adicional
				if (proyecto.contenido) {
					modalContenido.innerHTML = proyecto.contenido;
					modalContenido.style.display = 'block';
				} else {
					modalContenido.innerHTML = '';
					modalContenido.style.display = 'none';
				}
				
				// Link externo
				if (proyecto.link) {
					modalLink.href = proyecto.link;
					modalLink.style.display = 'inline-flex';
				} else {
					modalLink.style.display = 'none';
				}

				modal.classList.add('active');
				//document.body.style.overflow = 'hidden';
			}

			// Cerrar modal
			function closeModal() {
				modal.classList.remove('active');
				document.body.style.overflow = '';
			}

			// Compartir proyecto
			modalShare?.addEventListener('click', async () => {
				const titulo = modalTitulo.textContent;
				const url = window.location.href;
				
				if (navigator.share) {
					try {
						await navigator.share({
							title: titulo,
							text: `Mira este proyecto: ${titulo}`,
							url: url
						});
					} catch (err) {
						console.log('Error al compartir:', err);
					}
				} else {
					// Fallback: copiar URL
					navigator.clipboard.writeText(url);
					alert('URL copiada al portapapeles');
				}
			});

			// Event listeners para tarjetas de proyecto (ahora todas pueden abrir el modal)
			document.querySelectorAll('.proyecto-detail-card').forEach(card => {
				card.addEventListener('click', (e) => {
					// No abrir modal si se clickea en el link externo
					if (e.target.closest('.card-btn-link')) return;
					
					const proyectoId = card.dataset.proyectoId;
					openModal(proyectoId);
				});
			});

			// Cerrar con botón X
			modalClose?.addEventListener('click', closeModal);

			// Cerrar al clickear overlay (solo el fondo, no el contenido)
			modal?.addEventListener('click', (e) => {
				if (e.target === modal || e.target.classList.contains('modal-backdrop')) {
					closeModal();
				}
			});

			// Cerrar con Escape
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && modal.classList.contains('active')) {
					closeModal();
				}
			});
		});
	</script>
	<!-- #endregion -->
