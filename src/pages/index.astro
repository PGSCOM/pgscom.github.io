---
 // #region 📦 IMPORTS Y CONFIGURACIÓN INICIAL
 import Layout from '../layouts/Layout.astro';
 import './_styles.css';
 import '../styles/proyectos.css';
 import '../styles/contacto.css';
 import { Image } from 'astro:assets';
 import pgscom from '../assets/pgscom.png';
 import minimal1 from '../assets/minimal1.svg';
 import customShape from '../assets/custom-shape.svg';
 import minimal3 from '../assets/minimal3.svg';
 import logo from '../assets/logo.png';
// import logosvganim from '../assets/animlogo/logo.svg';
 
 // Importar datos de proyectos
 import proyectosData from '../data/proyectos.json';
 import contactoData from '../data/contacto.json';
 // #endregion
---

<!-- Cloudflare Turnstile -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<Layout>
	<!-- #region 🎯 SECCIÓN PRINCIPAL - Partículas flotantes y texto animado -->
	<!--div class="sky-image">
		<a href="/">
			<Image src={logo} height={70} alt="Logo PGSCOM" />
		</a>
	</div-->
	<main class="main-container">
		<div class="particles">
			<Image src={minimal1} alt="" class="particle particle-1" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-2" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-3" width={100} height={100} />
			<Image src={minimal1} alt="" class="particle particle-4" width={100} height={100} />
			<Image src={customShape} alt="" class="particle particle-5" width={100} height={100} />
			<Image src={minimal3} alt="" class="particle particle-6" width={100} height={100} />
		</div>
		<div class="content">
			<h1 id="animated-text" class="logo-text">PGSCOM</h1>
		</div>
	</main>
	<!-- #endregion -->

	<!-- #region 🧑‍💻 PERSONAJE PGSCOM - Imagen principal del personaje -->
	<div class="image-container">
		<Image 
			src={pgscom} 
			alt="PGSCOM Character" 
			class="fotopgs" 
			width={2617} 
			height={3490} 
			loading="eager" 
			widths={[320, 640, 1280, 2617]}
			sizes="(max-width: 768px) 100vw, 50vw"
		/>
	</div>
	<!-- #endregion -->

	<!-- #region 🌌 SECCIÓN GALAXIA - Video con sticky scroll y logo animado -->
	<!-- Wrapper alto para dar contexto de scroll y permitir que el sticky funcione -->
	<section class="parte2-wrapper">
		<div class="parte2">
			<div class="galaxiamask">
				<!-- Video Galaxia bucle -->
				<canvas id="galaxia-seq" class="video-galaxia" style="opacity:0;"></canvas>
				<video muted playsinline preload="auto" id="video-galaxia-a" class="video-galaxia"></video>
				<video muted playsinline preload="auto" id="video-galaxia-b" class="video-galaxia" style="opacity:0;"></video>
			</div>
			<img id="logoanimar" style="width: auto; height: 32.3%;" src="/assets/animlogo/logo.svg" alt="" />
			<!-- El width sería 18% (698/3840) y el height sería 32.3% (698/2160) -->
		</div>
	<!-- #endregion -->

	<!-- #region 🚧 SECCIONES TEMPORALES - Placeholder para contenido futuro -->
	<div style="height: 120vh; display: flex; align-items: center; justify-content: center; position: relative; z-index: 60;"></div>

	<!-- #region 📂 SECCIÓN DE PROYECTOS - Diseño circular con logo central -->
	<section class="proyectos-section">
		<div class="proyectos-container">
			<!-- Grid de aptitudes girando alrededor (órbita inicial) -->
			<div class="proyectos-grid">
				{proyectosData.map((aptitud) => (
					<div class="proyecto-card" data-aptitud-id={aptitud.id}>
						<div class="proyecto-card-inner">
							<div class="proyecto-icon">
								<img src={aptitud.logo} alt={aptitud.titulo} />
							</div>
							<h3 class="proyecto-titulo">{aptitud.titulo}</h3>
							<p class="proyecto-descripcion">{aptitud.descripcion}</p>
						</div>
					</div>
				))}
			</div>

			<!-- Logo en el centro (siempre visible) -->
			<div class="proyectos-logo">
				<Image 
					src={logo} 
					alt="PGSCOM Logo" 
					width={720} 
					height={720} 
					widths={[200, 400, 720]}
					sizes="(max-width: 768px) 150px, 200px"
				/>
			</div>

			<!-- Pantallas de detalle por aptitud (generadas proceduralmente) -->
			{proyectosData.map((aptitud, index) => (
				<div class="aptitud-detail-screen" data-aptitud-id={aptitud.id} data-index={index}>
					<!-- Línea que conecta logo con el círculo de aptitud -->
					<div class="line-logo-aptitud"></div>
					
					<!-- Círculo de aptitud (centro) -->
					<div class="aptitud-circle">
						<img src={aptitud.logo} alt={aptitud.titulo} />
						<span class="aptitud-title">{aptitud.titulo}</span>
					</div>
					
					<!-- Líneas que conectan aptitud con proyectos -->
					<div class="lines-to-projects">
						{aptitud.proyectos && aptitud.proyectos.map((_, pIndex) => (
							<div class="line-aptitud-proyecto" data-project-index={pIndex}></div>
						))}
					</div>
					
					<!-- Proyectos de esta aptitud -->
					<div class="proyectos-list">
						{aptitud.proyectos && aptitud.proyectos.map((proyecto, pIndex) => (
							<div 
								class="proyecto-detail-card" 
								data-project-index={pIndex}
								data-proyecto-id={proyecto.id}
								data-tiene-contenido={proyecto.contenido ? "true" : "false"}
							>
								<div class="proyecto-image-container">
									<img src={proyecto.imagen} alt={proyecto.titulo} class="proyecto-image" />
								</div>
								<div class="proyecto-info">
									<h4 class="proyecto-detail-titulo">{proyecto.titulo}</h4>
									{proyecto.descripcion && (
										<p class="proyecto-detail-desc">{proyecto.descripcion}</p>
									)}
									{proyecto.tecnologias && (
										<div class="proyecto-tecnologias">
											{proyecto.tecnologias.slice(0, 3).map((tech) => (
												<span class="tech-tag">{tech}</span>
											))}
											{proyecto.tecnologias.length > 3 && (
												<span class="tech-tag tech-more">+{proyecto.tecnologias.length - 3}</span>
											)}
										</div>
									)}
								</div>
								<div class="card-actions">
									{proyecto.contenido && (
										<span class="card-btn card-btn-info" title="Ver más información">
											<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<circle cx="12" cy="12" r="10"></circle>
												<line x1="12" y1="16" x2="12" y2="12"></line>
												<line x1="12" y1="8" x2="12.01" y2="8"></line>
											</svg>
										</span>
									)}
									{proyecto.link && (
										<a href={proyecto.link} target="_blank" rel="noopener noreferrer" class="card-btn card-btn-link" title="Visitar proyecto" onclick="event.stopPropagation();">
											<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
												<polyline points="15 3 21 3 21 9"></polyline>
												<line x1="10" y1="14" x2="21" y2="3"></line>
											</svg>
										</a>
									)}
								</div>
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</section>
	<!-- #endregion -->

	<!-- #region 🪟 MODAL DE PROYECTO -->
	<div class="proyecto-modal-overlay" id="proyectoModal">
		<div class="proyecto-modal">
			<button class="modal-close" id="modalClose" aria-label="Cerrar modal">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
			
			<!-- Imagen de fondo hero -->
			<div class="modal-backdrop">
				<img class="modal-backdrop-img" id="modalBackdrop" src="" alt="" />
			</div>
			
			<!-- Contenido scrolleable -->
			<div class="modal-content-wrapper">
				<!-- Sección hero con poster y título -->
				<div class="modal-hero">
					<div class="modal-poster-container">
						<img class="modal-poster" id="modalPoster" src="" alt="" />
					</div>
					<div class="modal-hero-info">
						<h1 class="modal-titulo" id="modalTitulo"></h1>
						<div class="modal-meta" id="modalMeta">
							<!-- Se llenará dinámicamente -->
						</div>
						<p class="modal-tagline" id="modalTagline"></p>
						<div class="modal-actions">
							<a href="#" target="_blank" rel="noopener noreferrer" class="modal-btn-primary" id="modalLink" style="display: none;">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
									<polygon points="5 3 19 12 5 21 5 3"></polygon>
								</svg>
								<span>Visitar proyecto</span>
							</a>
							<button class="modal-btn-secondary" id="modalShare" title="Compartir">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="18" cy="5" r="3"></circle>
									<circle cx="6" cy="12" r="3"></circle>
									<circle cx="18" cy="19" r="3"></circle>
									<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
									<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
								</svg>
							</button>
						</div>
					</div>
				</div>
				
				<!-- Cuerpo del modal -->
				<div class="modal-body">
					<!-- Descripción -->
					<div class="modal-description">
						<p class="modal-description-text" id="modalDescripcion"></p>
					</div>
					
					<!-- Tecnologías -->
					<div class="modal-tecnologias" id="modalTecnologias"></div>
					
					<!-- Contenido HTML adicional -->
					<div class="modal-contenido" id="modalContenido"></div>
				</div>
			</div>
		</div>
	</div>
	<!-- #endregion -->
	<!-- #endregion -->
	</section>

	<!-- #region 📧 SECCIÓN DE CONTACTO - Formulario y datos de contacto -->
	<section class="contacto-section">
		<div class="contacto-wrapper">
			<!-- Partículas de fondo -->
			<div class="contacto-particles">
				<div class="particle-space"></div>
				<div class="particle-space"></div>
				<div class="particle-space"></div>
				<div class="particle-space"></div>
				<div class="particle-space"></div>
			</div>

			<!-- Contenedor principal de contacto -->
			<div class="contacto-container">
				<!-- Título de la sección -->
				<div class="contacto-header">
					<h2 class="contacto-titulo">Contacto</h2>
					<p class="contacto-subtitulo">¿Tienes un proyecto en mente? ¡Hablemos!</p>
				</div>

				<!-- Grid de contenido -->
				<div class="contacto-grid">
					<!-- Información de contacto -->
					<div class="contacto-info">
						{contactoData.informacion.email && (
							<div class="info-card">
								<div class="info-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
										<polyline points="22,6 12,13 2,6"></polyline>
									</svg>
								</div>
								<div class="info-content">
									<h3>Email</h3>
									<a href={`mailto:${contactoData.informacion.email}`}>{contactoData.informacion.email}</a>
								</div>
							</div>
						)}

						{contactoData.informacion.telefono && (
							<div class="info-card">
								<div class="info-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
									</svg>
								</div>
								<div class="info-content">
									<h3>Teléfono</h3>
									<a href={`tel:${contactoData.informacion.telefono}`}>{contactoData.informacion.telefono}</a>
								</div>
							</div>
						)}

						{contactoData.informacion.ubicacion && (
							<div class="info-card">
								<div class="info-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
										<circle cx="12" cy="10" r="3"></circle>
									</svg>
								</div>
								<div class="info-content">
									<h3>Ubicación</h3>
									<p>{contactoData.informacion.ubicacion}</p>
								</div>
							</div>
						)}

						<!-- Redes sociales -->
						<div class="social-links">
							<h3>Sígueme en redes</h3>
							<div class="social-icons">
								{contactoData.redes.map((red) => (
									<a href={red.url} target="_blank" rel="noopener noreferrer" class="social-icon" title={red.nombre}>
										<span class="sr-only">{red.nombre}</span>
										<img src={red.icono} alt={red.nombre} width="24" height="24" />
									</a>
								))}
							</div>
						</div>
					</div>

					<!-- Formulario de contacto -->
					<div class="contacto-form-container">
						<form class="contacto-form" id="contactForm">
							<div class="form-group">
								<label for="nombre">Nombre</label>
								<input 
									type="text" 
									id="nombre" 
									name="nombre" 
									placeholder="Tu nombre completo"
									required
								/>
								<span class="input-border"></span>
							</div>

							<div class="form-group">
								<label for="email">Email</label>
								<input 
									type="email" 
									id="email" 
									name="email" 
									placeholder="tu@email.com"
									required
								/>
								<span class="input-border"></span>
							</div>

							<div class="form-group">
								<label for="asunto">Asunto</label>
								<input 
									type="text" 
									id="asunto" 
									name="asunto" 
									placeholder="¿De qué se trata?"
									required
								/>
								<span class="input-border"></span>
							</div>

							<div class="form-group">
								<label for="mensaje">Mensaje</label>
								<textarea 
									id="mensaje" 
									name="mensaje" 
									placeholder="Cuéntame sobre tu proyecto..."
									rows="5"
									required
								></textarea>
								<span class="input-border"></span>
							</div>

							<!-- Cloudflare Turnstile Widget (Invisible) -->
							<div class="cf-turnstile" data-sitekey="0x4AAAAAACGiv6Et8KLomzvb" data-theme="dark"></div>

							<button type="submit" class="submit-btn">
								<span class="btn-text">Enviar mensaje</span>
								<span class="btn-icon">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<line x1="22" y1="2" x2="11" y2="13"></line>
										<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
									</svg>
								</span>
							</button>

							<!-- Mensaje de estado -->
							<div class="form-status" id="formStatus"></div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- #endregion -->

	<!-- #region 🌀 SCRIPT: Órbita con pausa suave -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const container = document.querySelector('.proyectos-section .proyectos-container');
			if (!container) return;

			const cards = Array.from(container.querySelectorAll('.proyecto-card'));
			if (cards.length === 0) return;

			const TWO_PI = Math.PI * 2;

			// Más lento: 1 vuelta cada 90s (ajusta aquí si quieres)
			const REV_SECONDS = 90;
			const DEFAULT_SPEED = TWO_PI / REV_SECONDS; // rad/s
			const SMOOTH_TAU_STOP = 0.22; // s (frenada)
			const SMOOTH_TAU_START = 0.35; // s (arranque)

			let angle = 0;
			let speed = DEFAULT_SPEED;
			let targetSpeed = DEFAULT_SPEED;
			let lastT = performance.now();

			const baseAngles = cards.map((_, index) => (TWO_PI * index) / cards.length);

			const readRadius = () => {
				const raw = getComputedStyle(container).getPropertyValue('--orbit-radius').trim();
				const radius = Number.parseFloat(raw);
				return Number.isFinite(radius) ? radius : 350;
			};

			const setPaused = (paused) => {
				targetSpeed = paused ? 0 : DEFAULT_SPEED;
			};

			// Pausa estable aunque las tarjetas estén moviéndose bajo el cursor:
			// guardamos última posición del ratón y hacemos hit-test cada frame.
			let pointerActive = false;
			let pointerX = 0;
			let pointerY = 0;
			let hoverOffAt = 0;
			const HOVER_RELEASE_DELAY_MS = 140;

			container.addEventListener('pointerenter', (e) => {
				pointerActive = true;
				pointerX = e.clientX;
				pointerY = e.clientY;
			});
			container.addEventListener('pointermove', (e) => {
				pointerActive = true;
				pointerX = e.clientX;
				pointerY = e.clientY;
			});
			container.addEventListener('pointerleave', () => {
				pointerActive = false;
				hoverOffAt = 0;
				setPaused(false);
			});

			const tick = (t) => {
				const dt = Math.min(0.05, Math.max(0.001, (t - lastT) / 1000));
				lastT = t;

				// Hover real sobre tarjeta (sin depender de enter/leave de elementos en movimiento)
				if (pointerActive) {
					const el = document.elementFromPoint(pointerX, pointerY);
					const isOnCard = !!(el && container.contains(el) && el.closest('.proyecto-card'));
					if (isOnCard) {
						hoverOffAt = 0;
						setPaused(true);
					} else {
						if (!hoverOffAt) hoverOffAt = t;
						if (t - hoverOffAt > HOVER_RELEASE_DELAY_MS) setPaused(false);
					}
				}

				// Suavizar aceleración/frenada
				const tau = (targetSpeed < speed) ? SMOOTH_TAU_STOP : SMOOTH_TAU_START;
				const k = 1 - Math.exp(-dt / tau);
				speed += (targetSpeed - speed) * k;
				// Importante: no hacer modulo aquí para evitar micro-saltos al cruzar 0/360
				angle += speed * dt;

				const r = readRadius();
				for (let i = 0; i < cards.length; i += 1) {
					const a = angle + baseAngles[i];
					const deg = (a * 180) / Math.PI;
					cards[i].style.transform = `translate(-50%, -50%) rotate(${deg}deg) translateX(${r}px) rotate(${-deg}deg)`;
				}

				requestAnimationFrame(tick);
			};

			requestAnimationFrame(tick);
		});
	</script>
	<!-- #endregion -->

	<!-- #region 🎨 SCRIPT: ANIMACIÓN DE FUENTES - Rotación automática de tipografías -->
	<script is:inline defer>
		document.addEventListener('DOMContentLoaded', async () => {
			const animatedText = document.getElementById('animated-text');
			
			// Array de fuentes disponibles
			const fonts = [
				'Allerta Stencil',
				'Bungee Inline',
				'Chakra Petch',
				'Kranky',
				'Limelight',
				'Meow Script',
				'Modak',
				'Monoton',
				'Offside',
				'Pacifico',
				'Permanent Marker',
				'Rampart One',
				'Solway',
				'Tapestry',
				'Tiny5',
			];
			
			// Factor de escala para cada fuente para mantener tamaño visual consistente
			const fontSizeFactors = {
				'Allerta Stencil': 1.0,
				'Bungee Inline': 0.9,
				'Chakra Petch': 1,
				'Kranky': 1.0,
				'Limelight': 0.95,
				'Meow Script': 0.85,
				'Modak': 1.0,
				'Monoton': 0.8,
				'Offside': 1.1,
				'Pacifico': 0.8,
				'Permanent Marker': 1.0,
				'Rampart One': 0.8,
				'Solway': 1.15,
				'Tapestry': 1.05,
				'Tiny5': 1.2,
			};
			
			// Base font size in viewport width units
			const baseFontSize = 7; // corresponde al 7cqw en CSS
			const delayfont = 5000;
			
			// Variables de duración de transición
			const transitionDuration = {
				fadeOut: 600,    // Duración del fade-out en ms
				fadeIn: 800,     // Duración del fade-in en ms
				get total() { return this.fadeOut + this.fadeIn; } // Duración total
			};
			
			let currentFontIndex = 0;
			let fontsLoaded = false;

			// Función para precargar todas las fuentes
			async function preloadFonts() {
				console.log('Precargando fuentes...');
				
				try {
					// Usar Font Loading API si está disponible
					if ('fonts' in document) {
