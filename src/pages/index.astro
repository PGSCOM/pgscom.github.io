	<!-- #region 🎬 SCRIPT: ANIMACIONES SCROLL - Timeline principal con videos -->
	<script type="module">
    import gsap from 'https://cdn.jsdelivr.net/npm/gsap@3.12.7/+esm';
    import ScrollTrigger from 'https://cdn.jsdelivr.net/npm/gsap@3.12.7/ScrollTrigger/+esm';
    
    gsap.registerPlugin(ScrollTrigger);

    function initScrollAnim() {
        const targetEl = document.querySelector('.image-container');
        const logoEl = document.querySelector('#logoanimar');
        const galaxiaMaskEl = document.querySelector('.galaxiamask');
        const videoA = document.querySelector('#video-galaxia-a');
        const videoB = document.querySelector('#video-galaxia-b');

        if (!targetEl || !logoEl || !galaxiaMaskEl || !videoA || !videoB) return;

        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        
        // #region 🎯 CONFIGURACIÓN TIMELINE
        const timeline = gsap.timeline({ paused: true });
        gsap.config({ force3D: true });

        timeline.fromTo(targetEl, 
            { opacity: 1, scale: 1 },
            { opacity: 0, scale: 0.8, duration: isMobile ? 0.311 : 0.8, ease: 'power2.out', force3D: true }, 0)
        .fromTo(logoEl,
            { scale: 1, y: 0 },
            {
                scale: 25, y: 45, duration: 1, ease: 'power2.in', force3D: true,
                onUpdate: function() {
                    const rect = logoEl.getBoundingClientRect();
                    const currentSize = (rect.height / window.innerHeight) * 100 - 8;
                    galaxiaMaskEl.style.webkitMaskSize = `${currentSize}vh ${currentSize}vh`;
                    galaxiaMaskEl.style.maskSize = `${currentSize}vh ${currentSize}vh`;
                }
            }, 1)
        .to(logoEl, { opacity: 0, duration: 0.001, ease: 'none' }, 1.8);
        // #endregion

		// #region 📹 CONFIGURACIÓN DE VIDEOS
		const ZOOM_START_MS = 1000;
		const ZOOM_END_MS = 2000;
		const SCRUB_DURATION_S = 2; 

		// Las 3 fases de video
		const VIDEO_SCROLL = '/vid/empezar_scroll.mp4'; // El vídeo All-Intra de 2s
		const VIDEO_INTRO_FULL = 'https://pgscom.github.io/webvid/empezar.mp4';    // El vídeo original completo
		const PLAYLIST = ['https://pgscom.github.io/webvid/loopinversed.mp4', 'https://pgscom.github.io/webvid/loop.mp4'];
		
		let playlistIndex = 0;
		let isScrollScrubActive = true;
		let afterZoomPlaybackStarted = false;
		let activeMetadataReady = false;
		let playlistStarted = false;

		let activeVideo = videoA;
		let bufferVideo = videoB;

		let pendingScrubT = null;
		let scrubRafId = 0;
		const SCRUB_EPS = 0.02;

		function applyScrub() {
			scrubRafId = 0;
			if (pendingScrubT == null || !activeMetadataReady) return;
			const t = pendingScrubT;
			pendingScrubT = null;
			try {
				const cur = activeVideo.currentTime || 0;
				if (Math.abs(cur - t) < SCRUB_EPS) return;
				if (typeof activeVideo.fastSeek === 'function') {
					activeVideo.fastSeek(t);
				} else {
					activeVideo.currentTime = t;
				}
			} catch {}
		}

		function scheduleScrub(t) {
			pendingScrubT = t;
			if (!scrubRafId) scrubRafId = requestAnimationFrame(applyScrub);
		}

		function waitForMetadata(el) {
			return new Promise((resolve) => {
				if (el.readyState >= 1 && !isNaN(el.duration)) { resolve(); return; }
				const onLoaded = () => { el.removeEventListener('loadedmetadata', onLoaded); resolve(); };
				el.addEventListener('loadedmetadata', onLoaded, { once: true });
			});
		}

		async function setVideoSource(el, src, startTime = 0, autoplay = false) {
			try {
				el.loop = false;
				if (el.src !== location.origin + src && el.src !== src) el.src = src;
				el.load();
				await waitForMetadata(el);
				if (el === activeVideo) activeMetadataReady = true;
				
				const clampedStart = Math.max(0, Math.min(startTime, (el.duration || Infinity)));
				if (!Number.isNaN(clampedStart)) { try { el.currentTime = clampedStart; } catch {} }
				
				if (autoplay) { try { await el.play(); } catch {} } 
				else { el.pause(); }
			} catch (e) {}
		}

		async function prepareNext(src, startTime = 0) {
			await setVideoSource(bufferVideo, src, startTime, false);
			// Truco: reproducir y pausar rápidamente prepara el decodificador sin parpadeos
			try { await bufferVideo.play(); bufferVideo.pause(); } catch {}
		}

		function attachEndedHandler() {
			activeVideo.onended = async () => {
				if (!playlistStarted) playlistStarted = true;
				// Cuando acaba normal (desde el segundo video), sí reiniciamos el tiempo a 0
				await swapToPreloaded(true);
				playlistIndex = (playlistIndex + 1) % PLAYLIST.length;
				prepareNext(PLAYLIST[playlistIndex], 0);
			};
			bufferVideo.onended = null;
		}

		async function swapToPreloaded(resetTime = true) {
			if (resetTime) {
				try { bufferVideo.currentTime = 0; } catch {}
			}
			try { await bufferVideo.play(); } catch {}
			bufferVideo.style.opacity = '1';
			
			await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));
			
			activeVideo.style.opacity = '0';
			try { activeVideo.pause(); } catch {}
			
			const tmp = activeVideo; activeVideo = bufferVideo; bufferVideo = tmp;
			attachEndedHandler();
		}

		// INICIALIZACIÓN MÁGICA:
		// 1. Preparamos el video All-Intra en 0s para el scroll
		setVideoSource(activeVideo, VIDEO_SCROLL, 0, false);
		// 2. Preparamos en el buffer el video Original clavado en el segundo 2.0
		prepareNext(VIDEO_INTRO_FULL, SCRUB_DURATION_S);

        function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
		// #endregion

		// #region 📜 MANEJO DE SCROLL
		const ZOOM_START_S = ZOOM_START_MS / 1000;
		const ZOOM_END_S = ZOOM_END_MS / 1000;
		
		function onScroll() {
			const scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop;
			const ANIMATION_VH = 2; 
			const viewportHeight = window.innerHeight;
			
			const progress = clamp(scrollY / (ANIMATION_VH * viewportHeight), 0, 1);
			const totalDuration = timeline.duration();
			const seekTime = progress * totalDuration;

			timeline.progress(progress);

			if (isScrollScrubActive) {
				if (seekTime <= ZOOM_START_S) {
					try { if (!activeVideo.paused) activeVideo.pause(); } catch {}
					scheduleScrub(0);
					
				} else if (seekTime < ZOOM_END_S) {
					const localP = (seekTime - ZOOM_START_S) / (ZOOM_END_S - ZOOM_START_S);
					const videoTime = localP * SCRUB_DURATION_S;
					try { if (!activeVideo.paused) activeVideo.pause(); } catch {}
					scheduleScrub(videoTime);
					
				} else {
					if (!afterZoomPlaybackStarted && activeMetadataReady) {
						afterZoomPlaybackStarted = true;
						isScrollScrubActive = false; 
						
						// Hacemos swap al video original completo conservando el tiempo en 2.0s
						swapToPreloaded(false).then(() => {
							// Una vez hecho el swap, preparamos el loop en el reproductor libre
							prepareNext(PLAYLIST[playlistIndex], 0);
						});
						
						pendingScrubT = null;
						if (scrubRafId) { cancelAnimationFrame(scrubRafId); scrubRafId = 0; }
					}
				}
			}
		}

        onScroll();
        let rafPending = false;
        window.addEventListener('scroll', () => {
          if (!rafPending) {
            rafPending = true;
            requestAnimationFrame(() => {
              onScroll();
              rafPending = false;
            });
          }
        }, { passive: true });
		// #endregion
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollAnim);
    } else {
        initScrollAnim();
    }
	</script>
