---
// Fila compacta de un proyecto con `experimento: true`, compartida por la lista
// bajo la Rejilla y por el final de cada año de la Cronología. Lleva
// `rejilla-item` para que el filtro por disciplina la atenúe en las dos vistas.
import { Image } from 'astro:assets';
import IaTrazo from './IaTrazo.astro';
import { etiquetaIA } from '../utils/ia.js';

interface Props {
	proyecto: any;
}

const { proyecto: p } = Astro.props;
---

<a
	class={`exp-fila rejilla-item${p.imagen ? '' : ' sin-imagen'}`}
	{...(p.paginaPropia
		? { href: `/proyectos/${p.id}`, 'data-proyecto-link': true }
		: { href: p.enlaceExterno ?? p.link, target: '_blank', rel: 'noopener noreferrer' })}
	data-cats={p.catIds.join(',')}
	data-ia={p.estadoIA ?? 'sin'}
	style={`--cat-color:${p.color}`}
>
	<span class="exp-thumb">
		{p.imagen
			? <Image src={p.imagen} alt="" width={176} loading="lazy" decoding="async" />
			: p.cats[0] && <img class="exp-thumb-fallback" src={p.cats[0].logo} alt="" aria-hidden="true" loading="lazy" />}
	</span>
	<span class="exp-texto">
		<strong class="exp-nombre">{p.titulo.trim()}</strong>
		{p.descripcion && <span class="exp-desc">{p.descripcion}</span>}
		{p.estadoIA && (
			<span class="exp-ia">
				<IaTrazo ancho={24} />
				{p.textotarjetaIA ?? etiquetaIA[p.estadoIA]}
			</span>
		)}
	</span>
	<span class="exp-año">{String(p.fecha ?? '').slice(0, 4)}</span>
	<svg class="exp-flecha" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
</a>
