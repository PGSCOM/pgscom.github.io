---
// Cabecera cinematográfica compartida por toda ficha de proyecto: trailer o
// portada a pantalla completa con degradado, migas de pan, título, fecha,
// premio, tagline y botón de enlace externo. La usan tanto la plantilla
// genérica (src/pages/proyectos/[id].astro) como los micrositios a medida
// (p.ej. src/pages/proyectos/multiguerras.astro) para que un cambio de
// diseño aquí se refleje en todas las fichas a la vez.
import { Image, getImage } from 'astro:assets';

interface Props {
	titulo: string;
	breadcrumbActual: string;
	descripcion?: string;
	fechaTexto?: string;
	premio?: string;
	link?: string;
	portada?: ImageMetadata;
	trailer?: string;
	logoFallback: string;
}

const { titulo, breadcrumbActual, descripcion, fechaTexto, premio, link, portada, trailer, logoFallback } = Astro.props;

// Póster del trailer: webp optimizado (el atributo `poster` no pasa por
// <Image>, así que con `.src` directo cargaría el asset original completo).
const posterTrailer = trailer && portada
	? (await getImage({ src: portada, format: 'webp', width: 1600 })).src
	: undefined;
---

<header class="pd-hero">
	{trailer ? (
		<video
			class="pd-hero-media"
			data-src={trailer}
			poster={posterTrailer}
			muted
			loop
			playsinline
			aria-hidden="true"
		></video>
	) : portada ? (
		<Image
			class="pd-hero-media"
			src={portada}
			alt={titulo}
			style="view-transition-name: project-hero"
			loading="eager"
		/>
	) : (
		<img
			class="pd-hero-media pd-hero-media--icono"
			src={logoFallback}
			alt={titulo}
			style="view-transition-name: project-hero"
			loading="eager"
		/>
	)}

	<div class="pd-hero-overlay">
		<!-- Migas de pan rastreables -->
		<nav class="pd-breadcrumb" aria-label="Migas de pan">
			<a href="/">Inicio</a>
			<span aria-hidden="true">/</span>
			<a href="/?sincarga#proyectos-mapa">Proyectos</a>
			<span aria-hidden="true">/</span>
			<span class="pd-breadcrumb-current">{breadcrumbActual}</span>
		</nav>

		<div class="pd-hero-info">
			<h1 class="pd-titulo">{titulo}</h1>

			<div class="pd-meta">
				{fechaTexto && <span class="pd-meta-item">📅 {fechaTexto}</span>}
				{premio && <span class="pd-meta-badge">🏆 {premio}</span>}
			</div>

			{descripcion && <p class="pd-tagline">{descripcion}</p>}

			<div class="pd-actions">
				{link && (
					<a class="pd-btn-primary" href={link} target="_blank" rel="noopener noreferrer">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<polygon points="5 3 19 12 5 21 5 3"></polygon>
						</svg>
						<span>Visitar proyecto</span>
					</a>
				)}
			</div>
			<div class="pd-scroll-hint" aria-hidden="true">
				<svg class="pd-scroll-hint-svg" viewBox="0 0 24 30" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path class="pd-scroll-hint-path" d="M12 2 V22 M4 14 L12 22 L20 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</div>
		</div>
	</div>
</header>
