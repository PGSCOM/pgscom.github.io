---
// Cabecera cinematográfica compartida por toda ficha de proyecto: trailer o
// portada a pantalla completa con degradado, migas de pan, título, fecha,
// premio, tagline y botón de enlace externo. La usan tanto la plantilla
// genérica (src/pages/proyectos/[id].astro) como los micrositios a medida
// (p.ej. src/pages/proyectos/multiguerras.astro) para que un cambio de
// diseño aquí se refleje en todas las fichas a la vez.
//
// Composición: el bloque de texto se ancla abajo a la izquierda, sobre el
// mismo margen que usa .pd-wrapper para el cuerpo (ver .pd-hero-inner en
// proyecto-detalle.css) — no es la pila centrada por defecto. La pista de
// scroll pasa a la esquina opuesta, abajo a la derecha, como segunda pieza
// de la misma fila en vez de cerrar la pila.
import { Image, getImage } from 'astro:assets';
import { palabrasLetras } from '../utils/titulo.js';
import { etiquetaIA } from '../utils/ia.js';
import IaTrazo from './IaTrazo.astro';

interface Props {
	titulo: string;
	breadcrumbActual: string;
	descripcion?: string;
	fechaTexto?: string;
	premio?: string;
	link?: string;
	txtboton?: string;
	portada?: ImageMetadata;
	trailer?: string;
	logoFallback: string;
	// Degradado letra a letra del título (ver src/styles/titulo-proyecto.css).
	// `true` usa los colores por defecto; un par de colores los sustituye.
	tituloDegradado?: boolean | string[];
	// Aviso de IA junto a la fecha; sin él no se pinta nada
	estadoIA?: 'asistido' | 'generado';
}

const { titulo, breadcrumbActual, descripcion, fechaTexto, premio, link, txtboton, portada, trailer, logoFallback, tituloDegradado, estadoIA } = Astro.props;
const [gradA, gradB] = Array.isArray(tituloDegradado) ? tituloDegradado : [];

// Póster del trailer: webp optimizado (el atributo `poster` no pasa por
// <Image>, así que con `.src` directo cargaría el asset original completo).
const posterTrailer = trailer && portada
	? (await getImage({ src: portada, format: 'webp', width: 1600 })).src
	: undefined;
---

<header class="pd-hero" style={posterTrailer ? `background-image:url("${posterTrailer}")` : undefined}>
	{trailer ? (
		<video
			class="pd-hero-media"
			data-src={trailer}
			muted
			loop
			playsinline
			aria-hidden="true"
		></video>
	) : portada ? (
		<Image
			class="pd-hero-media"
			src={portada}
			alt={titulo}
			style="view-transition-name: project-hero"
			loading="eager"
			fetchpriority="high"
			format="webp"
			widths={[640, 1080, 1600, 2000]}
			sizes="100vw"
		/>
	) : (
		<img
			class="pd-hero-media pd-hero-media--icono"
			src={logoFallback}
			alt={titulo}
			style="view-transition-name: project-hero"
			loading="eager"
		/>
	)}

	<div class="pd-hero-overlay">
		<div class="pd-hero-inner">
			<div class="pd-hero-info">
				<!-- Migas de pan: sobre el mismo margen que el título, no centradas
				     arriba por su cuenta. -->
				<nav class="pd-breadcrumb" aria-label="Migas de pan">
					<a href="/">Inicio</a>
					<span aria-hidden="true">/</span>
					<a href="/?sincarga#proyectos-mapa">Proyectos</a>
					<span aria-hidden="true">/</span>
					<span class="pd-breadcrumb-current">{breadcrumbActual}</span>
				</nav>

				{tituloDegradado ? (
					<h1
						class="pd-titulo titulo-degradado"
						style={(gradA && gradB) ? `--titulo-grad-a:${gradA};--titulo-grad-b:${gradB}` : undefined}
						aria-label={titulo}
					>
						<span aria-hidden="true">
							{palabrasLetras(titulo).map((letras: string[], i: number) => (
								<Fragment>
									{i > 0 && ' '}
									<span class="titulo-palabra">{letras.map((c: string) => <span>{c}</span>)}</span>
								</Fragment>
							))}
						</span>
					</h1>
				) : (
					<h1 class="pd-titulo">{titulo}</h1>
				)}

				<div class="pd-meta">
					{fechaTexto && <span class="pd-meta-item">{fechaTexto}</span>}
					{premio && <span class="pd-meta-item pd-meta-item--premio">{premio}</span>}
					{estadoIA && (
						<span class="pd-meta-item pd-meta-item--ia">
							<IaTrazo ancho={28} />
							{etiquetaIA[estadoIA]}
						</span>
					)}
				</div>

				{descripcion && <p class="pd-tagline">{descripcion}</p>}

				<div class="pd-actions">
					{link && (
						<a class="pd-btn-primary" href={link} target="_blank" rel="noopener noreferrer">
							<svg class="pd-btn-primary-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
								<polygon points="5 3 19 12 5 21 5 3"></polygon>
							</svg>
							<span>{txtboton ?? 'Visitar proyecto'}</span>
						</a>
					)}
				</div>
			</div>

			<div class="pd-scroll-hint" aria-hidden="true">
				<svg class="pd-scroll-hint-svg" viewBox="0 0 24 30" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path class="pd-scroll-hint-path" d="M12 2 V22 M4 14 L12 22 L20 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</div>
		</div>
	</div>
</header>
